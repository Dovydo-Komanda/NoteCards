
<UserControl x:Class="NoteCards.Controls.NoteCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="220" MinHeight="140" Margin="12"
             RenderTransformOrigin="0.5,0.5"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextOptions.TextFormattingMode="Display"
             TextOptions.TextRenderingMode="ClearType"
             Opacity="0"
             AllowDrop="True"
             DataContextChanged="OnDataContextChanged"
             PreviewMouseLeftButtonDown="OnPreviewMouseLeftButtonDown"
             PreviewMouseRightButtonUp="OnPreviewMouseRightButtonUp"
             MouseMove="OnMouseMove"
             DragEnter="OnDragEnter"
             DragLeave="OnDragLeave"
             DragOver="OnDragOver"
             Drop="OnDrop"
             MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
    <UserControl.Resources>
        <Storyboard x:Key="ExitStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleX"
                             From="1.0" To="0.88" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="CardScale"
                             Storyboard.TargetProperty="ScaleY"
                             From="1.0" To="0.88" Duration="0:0:0.2">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>
    <UserControl.RenderTransform>
        <ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/>
    </UserControl.RenderTransform>
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.25">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.88" To="1.0" Duration="0:0:0.32">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.25"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.88" To="1.0" Duration="0:0:0.32">
                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.25"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseEnter">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CardBorder"
                                     Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                     To="14" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardBorder"
                                     Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                     To="0.18" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     To="1.02" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     To="1.02" Duration="0:0:0.18">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
        <EventTrigger RoutedEvent="MouseLeave">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CardBorder"
                                     Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                     To="8" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardBorder"
                                     Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                     To="0.08" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     To="1.0" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="CardScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     To="1.0" Duration="0:0:0.2">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>
    <Border x:Name="CardBorder"
            Background="{DynamicResource NoteCardBackground}"
            BorderBrush="{DynamicResource NoteCardBorder}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="8"
                              ShadowDepth="1" Direction="270"/>
        </Border.Effect>
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding DataContext.IsMassSelectMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                            <Condition Binding="{Binding IsSelectedInMassSelect}" Value="True"/>
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{DynamicResource NoteCardSelection}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource NoteCardSelectionBorder}"/>
                        <Setter Property="BorderThickness" Value="2"/>
                    </MultiDataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border x:Name="DropGlow"
                    Background="#00000000"
                    BorderBrush="#4A6EE0"
                    BorderThickness="0"
                    CornerRadius="12"
                    Opacity="0"
                    Grid.RowSpan="3"
                    Margin="-14"
                    Panel.ZIndex="50"
                    IsHitTestVisible="False"/>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="0,0,8,4">
                    <TextBlock Text="📌"
                               Foreground="{DynamicResource NoteCardTitle}"
                               FontSize="14"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding Document.IsPinned, Converter={StaticResource BoolToVis}}"
                               ToolTip="{Binding [Pin], Source={StaticResource Loc}}"/>
                    <TextBlock Text="🕒"
                               Foreground="{DynamicResource NoteCardTitle}"
                               FontSize="13"
                               Margin="0,0,6,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding HasSchedule, Converter={StaticResource BoolToVis}}"
                               ToolTip="{Binding Document.ScheduledAt, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"/>
                    <TextBlock Text="{Binding Title}"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{DynamicResource NoteCardTitle}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="MenuButton"
                        Grid.Column="1"
                        Content="&#x22EE;"
                        Foreground="{DynamicResource NoteCardTitle}"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Width="28" Height="28" Padding="0"
                        FontSize="16" FontWeight="Bold"
                        Background="Transparent"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        Cursor="Hand"
                        Click="OnMenuButtonClick">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="Transparent"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="MenuButtonBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MenuButtonBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
                                                <Setter TargetName="MenuButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="MenuButtonBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
                                                <Setter TargetName="MenuButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="Visibility" Value="{Binding IsMenuVisible, Converter={StaticResource BoolToVis}}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.IsMassSelectMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.ContextMenu>
                        <ContextMenu HasDropShadow="False"
                                     Background="{DynamicResource CardBackground}"
                                     BorderBrush="{DynamicResource BorderColor}"
                                     BorderThickness="1"
                                     Padding="0">
                            <ContextMenu.Template>
                                <ControlTemplate TargetType="ContextMenu">
                                    <Border Background="Transparent"
                                            Padding="8"
                                            ClipToBounds="False">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="10"
                                                Padding="4"
                                                ClipToBounds="False">
                                            <Border.Effect>
                                                <DropShadowEffect Color="#000000"
                                                                  Opacity="0.22"
                                                                  BlurRadius="16"
                                                                  ShadowDepth="3"
                                                                  Direction="270"/>
                                            </Border.Effect>
                                            <StackPanel IsItemsHost="True"
                                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                        </Border>
                                    </Border>
                                </ControlTemplate>
                            </ContextMenu.Template>
                            <MenuItem Header="{Binding [Open], Source={StaticResource Loc}}" Click="OnOpenMenuClick"/>
                            <MenuItem Header="{Binding [ReplaceFromFile], Source={StaticResource Loc}}" Click="OnOpenFromFileClick"/>
                            <MenuItem Header="{Binding [SelectMultiple], Source={StaticResource Loc}}" Click="OnStartMassSelectMenuClick"/>
                            <MenuItem Header="{Binding [CalendarAssignMenu], Source={StaticResource Loc}}" Click="OnAssignScheduleMenuClick"/>
                            <MenuItem Header="{Binding [Info], Source={StaticResource Loc}}" Click="OnInfoMenuClick"/>
                            <Separator/>
                            <MenuItem Header="{Binding [Pin], Source={StaticResource Loc}}"
                                      Command="{Binding TogglePinCommand}"
                                      Visibility="{Binding Document.IsPinned, Converter={StaticResource InverseBoolToVis}}"/>
                            <MenuItem Header="{Binding [Unpin], Source={StaticResource Loc}}"
                                      Command="{Binding TogglePinCommand}"
                                      Visibility="{Binding Document.IsPinned, Converter={StaticResource BoolToVis}}"/>
                            <MenuItem Header="{Binding [RemoveFromGroup], Source={StaticResource Loc}}"
                                      Command="{Binding RemoveFromGroupCommand}"
                                      Visibility="{Binding IsGrouped, Converter={StaticResource BoolToVis}}"/>
                            <MenuItem Header="{Binding [Duplicate], Source={StaticResource Loc}}" 
                            Command="{Binding DuplicateCommand}"/>
                            <MenuItem Header="{Binding [Delete], Source={StaticResource Loc}}" Command="{Binding DeleteCommand}"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>

                <CheckBox Grid.Column="1"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Top"
                          Width="22"
                          Height="22"
                          Margin="0,1,2,0"
                          IsHitTestVisible="False"
                          Focusable="False"
                          Panel.ZIndex="6"
                          Visibility="{Binding DataContext.IsMassSelectMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                          IsChecked="{Binding IsSelectedInMassSelect}">
                    <CheckBox.Template>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="SelectionBox"
                                    Background="{DynamicResource MassSelectBoxBackground}"
                                    BorderBrush="{DynamicResource MassSelectBoxBorder}"
                                    BorderThickness="1"
                                    CornerRadius="7">
                                <Border.RenderTransform>
                                    <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                </Border.RenderTransform>
                                <TextBlock x:Name="SelectionGlyph"
                                           Text=""
                                           Foreground="Transparent"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="SelectionBox" Property="Background" Value="{DynamicResource MassSelectBoxCheckedBackground}"/>
                                    <Setter TargetName="SelectionBox" Property="BorderBrush" Value="{DynamicResource MassSelectBoxCheckedBorder}"/>
                                    <Setter TargetName="SelectionGlyph" Property="Text" Value="✓"/>
                                    <Setter TargetName="SelectionGlyph" Property="Foreground" Value="{DynamicResource MassSelectBoxGlyph}"/>
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectionBox"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="1"
                                                                 Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase Amplitude="0.4" EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                                <DoubleAnimation Storyboard.TargetName="SelectionBox"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="1"
                                                                 Duration="0:0:0.12">
                                                    <DoubleAnimation.EasingFunction>
                                                        <BackEase Amplitude="0.4" EasingMode="EaseOut"/>
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetName="SelectionBox"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                 To="0.9"
                                                                 Duration="0:0:0.1"/>
                                                <DoubleAnimation Storyboard.TargetName="SelectionBox"
                                                                 Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                 To="0.9"
                                                                 Duration="0:0:0.1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </CheckBox.Template>
                </CheckBox>
            </Grid>
            <TextBlock Grid.Row="1"
                       Text="{Binding Content}"
                       FontSize="13" TextWrapping="Wrap"
                       MaxHeight="100"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextColor}"/>
            <Border Grid.Row="2"
                    Margin="0,10,0,0"
                    Padding="8,4"
                    Background="#F5F7FB"
                    CornerRadius="7"
                    Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding TagsDisplay}"
                           FontSize="11"
                           Foreground="#4A5D80"
                           TextTrimming="CharacterEllipsis"
                           TextWrapping="NoWrap"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
