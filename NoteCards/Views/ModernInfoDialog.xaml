<Window x:Class="NoteCards.Views.ModernInfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Info"
        Height="280"
        Width="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False">

    <Grid Background="#66000000">
        <Border x:Name="DialogCard"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="30,28,30,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="500">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.30" BlurRadius="36" ShadowDepth="0"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="48"
                            Height="48"
                            Background="{DynamicResource FlashcardKnownChipBackground}"
                            BorderBrush="{DynamicResource FlashcardKnownChipBorder}"
                            BorderThickness="1"
                            CornerRadius="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">
                        <TextBlock Text="✓"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource FlashcardKnownChipForeground}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,2,0,0">
                        <TextBlock Text="{Binding TitleText}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   TextWrapping="Wrap"
                                   LineHeight="26"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding MessageText}"
                           FontSize="14"
                           Foreground="{DynamicResource TextColor}"
                           Opacity="0.85"
                           TextWrapping="Wrap"
                           Margin="64,0,0,26"
                           LineHeight="20"/>

                <Button Grid.Row="2"
                        Content="{Binding OkText}"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        Padding="20,10"
                        MinWidth="110"
                        HorizontalAlignment="Right"
                        Click="OkButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
