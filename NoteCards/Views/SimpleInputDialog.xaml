<Window x:Class="NoteCards.Views.SimpleInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [SimpleInputTitle], Source={StaticResource Loc}}"
        MinHeight="185"
        SizeToContent="Height"
        Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource WindowBackground}">
    <Border Margin="10"
            Padding="14"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            CornerRadius="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="PromptText"
                       Grid.Row="0"
                       FontWeight="SemiBold"
                       FontSize="13"
                       Foreground="{DynamicResource TextColor}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,8"/>

            <TextBox x:Name="InputBox"
                     Grid.Row="1"
                     Margin="0,0,0,12"
                     MinHeight="34"
                     Padding="8,6"
                     FontSize="13"
                     Background="{DynamicResource WindowBackground}"
                     BorderBrush="{DynamicResource BorderColor}"
                     BorderThickness="1"
                     Foreground="{DynamicResource TextColor}"
                     CaretBrush="{DynamicResource TextColor}"
                     SelectionBrush="{DynamicResource SelectionBackground}"/>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{Binding [Cancel], Source={StaticResource Loc}}"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        MinWidth="84"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Click="Cancel_Click"/>
                <Button Content="{Binding [Ok], Source={StaticResource Loc}}"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        MinWidth="84"
                        Padding="14,7"
                        Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>