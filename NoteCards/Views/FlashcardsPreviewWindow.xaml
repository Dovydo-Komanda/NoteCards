<Window x:Class="NoteCards.Views.FlashcardsPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [FlashcardsPreviewTitle], Source={StaticResource Loc}}"
        Height="620"
        Width="980"
        MinHeight="460"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding [FlashcardsPreviewTitle], Source={StaticResource Loc}}"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextColor}"/>

        <TextBlock Grid.Row="2"
                   x:Name="ModelInfoText"
                   Foreground="{DynamicResource TextColorSecondary}"
                   FontSize="13"/>

        <TextBlock Grid.Row="4"
                   Text="{Binding [FlashcardsTapHint], Source={StaticResource Loc}}"
                   Foreground="{DynamicResource TextColorSecondary}"
                   FontSize="13"/>

        <Border Grid.Row="6"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="12"
                Background="{DynamicResource CardBackground}">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="14">
                <ItemsControl x:Name="FlashcardsItemsControl">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="300"
                                    Height="210"
                                    Margin="0,0,14,14"
                                    Padding="16"
                                    Background="{DynamicResource WindowBackground}"
                                    BorderBrush="{DynamicResource BorderColor}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    MouseLeftButtonUp="FlashcardCard_MouseLeftButtonUp"
                                    Cursor="Hand">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15"/>
                                </Border.Effect>

                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextColorSecondary}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding [FlashcardSideQuestion], Source={StaticResource Loc}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFlipped}" Value="True">
                                                        <Setter Property="Text" Value="{Binding [FlashcardSideAnswer], Source={StaticResource Loc}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Row="1"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Center"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextColor}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding Question}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFlipped}" Value="True">
                                                        <Setter Property="Text" Value="{Binding Answer}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <TextBlock Grid.Row="2"
                                               Text="{Binding [FlashcardsTapHint], Source={StaticResource Loc}}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextColorSecondary}"
                                               HorizontalAlignment="Right"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Content="{Binding [FlashcardsShowQuestions], Source={StaticResource Loc}}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    MinWidth="170"
                    Click="ShowQuestionsButton_Click"/>
            <Button Content="{Binding [FlashcardsShowAnswers], Source={StaticResource Loc}}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    MinWidth="170"
                    Margin="10,0,0,0"
                    Click="ShowAnswersButton_Click"/>
            <Button Content="{Binding [Close], Source={StaticResource Loc}}"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    MinWidth="120"
                    Margin="10,0,0,0"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
