<Window x:Class="NoteCards.Views.FlashcardsPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [FlashcardsPreviewTitle], Source={StaticResource Loc}}"
        Height="730"
        Width="980"
        MinHeight="730"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Closing="FlashcardsPreviewWindow_Closing">
    <Window.Resources>
        <ControlTemplate x:Key="SetSelectorToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="ComboBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1"
                               Text="▾"
                               FontSize="11"
                               Foreground="{TemplateBinding Foreground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                    <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                    <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="SetSelectorComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Template="{StaticResource SetSelectorToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}"/>
                            <TextBlock IsHitTestVisible="False"
                                       Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=''}"
                                       Margin="10,0,24,0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="180">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SetSelectorComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CreateSetButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style x:Key="FlashcardToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="FlashcardToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButtonStyle}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="FlashcardEditorIconButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
            <Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource IconButtonBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SearchIconBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SearchIconBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
                                <Setter TargetName="SearchIconBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SearchIconBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
                                <Setter TargetName="SearchIconBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FlashcardSearchIconButtonStyle" TargetType="Button" BasedOn="{StaticResource FlashcardEditorIconButtonStyle}"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,14,0"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TitleTextBox"
                                 Grid.Column="0"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextColor}"
                                 CaretBrush="{DynamicResource TextColor}"
                                 VerticalAlignment="Center"
                                 TextChanged="EditorField_TextChanged"
                                 ToolTip="{Binding [FlashcardsEditorTitle], Source={StaticResource Loc}}"/>
                        <TextBlock x:Name="EditedIndicatorText"
                                   Grid.Column="1"
                                   Text="{Binding [EditedIndicator], Source={StaticResource Loc}}"
                                   Margin="12,0,0,0"
                                   FontSize="12"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <Border x:Name="AiGeneratedInfoBadge"
                        Grid.Column="1"
                        Width="30"
                        Height="30"
                        CornerRadius="15"
                        Background="{DynamicResource IconButtonBackground}"
                        BorderBrush="{DynamicResource IconButtonBorder}"
                        BorderThickness="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTipService.InitialShowDelay="180"
                        Visibility="Collapsed">
                    <TextBlock Text="🤖"
                               FontSize="14"
                               Foreground="{DynamicResource TextColorSecondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="20,10,20,0"
                Padding="12,8"
                CornerRadius="10"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding [Tags], Source={StaticResource Loc}}"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="{DynamicResource TextColor}"
                           FontWeight="SemiBold"/>
                <TextBox x:Name="TagsTextBox"
                         Grid.Column="1"
                         BorderThickness="0"
                         Background="Transparent"
                         VerticalContentAlignment="Center"
                         Foreground="{DynamicResource TextColor}"
                         CaretBrush="{DynamicResource TextColor}"
                         TextChanged="EditorField_TextChanged"
                         ToolTip="{Binding [TagsHint], Source={StaticResource Loc}}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="20,10,20,0"
                Padding="10,8,10,2"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <WrapPanel Grid.Column="1"
                           Orientation="Horizontal"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Top">
                    <Button x:Name="FiltersButton"
                            Content="{Binding [FlashcardFilters], Source={StaticResource Loc}}"
                            Style="{StaticResource FlashcardToolbarButtonStyle}"
                            Margin="0,0,10,8"
                            Click="FiltersButton_Click"/>
                    <Popup x:Name="FiltersPopup"
                           PlacementTarget="{Binding ElementName=FiltersButton}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Margin="0,6,0,0"
                                Padding="10"
                                MinWidth="280"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <StackPanel Orientation="Vertical">
                                <ComboBox x:Name="StatusFilterComboBox"
                                          Width="260"
                                          Style="{StaticResource SetSelectorComboBoxStyle}"
                                          ItemContainerStyle="{StaticResource SetSelectorComboBoxItemStyle}"
                                          DisplayMemberPath="DisplayName"
                                          Margin="0,0,0,8"
                                          SelectionChanged="StatusFilterComboBox_SelectionChanged"/>
                                <ComboBox x:Name="CategoryFilterComboBox"
                                          Width="260"
                                          Style="{StaticResource SetSelectorComboBoxStyle}"
                                          ItemContainerStyle="{StaticResource SetSelectorComboBoxItemStyle}"
                                          DisplayMemberPath="DisplayName"
                                          Margin="0,0,0,8"
                                          SelectionChanged="CategoryFilterComboBox_SelectionChanged"/>
                                <Border Height="32"
                                        Padding="10,0"
                                        Margin="0,0,0,8"
                                        Background="{DynamicResource WindowBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                    <DockPanel LastChildFill="True">
                                        <TextBlock Text="⌕"
                                                   Foreground="{DynamicResource TextColorSecondary}"
                                                   Margin="0,0,8,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"/>
                                        <TextBox x:Name="FlashcardSearchTextBox"
                                                 BorderThickness="0"
                                                 Background="Transparent"
                                                 Foreground="{DynamicResource TextColor}"
                                                 CaretBrush="{DynamicResource TextColor}"
                                                 VerticalContentAlignment="Center"
                                                 TextChanged="FlashcardSearchTextBox_TextChanged"
                                                 ToolTip="{Binding [FlashcardSearchHint], Source={StaticResource Loc}}"/>
                                    </DockPanel>
                                </Border>
                                <Button Content="{Binding [ClearFilters], Source={StaticResource Loc}}"
                                        Style="{StaticResource FlashcardToolbarButtonStyle}"
                                        HorizontalAlignment="Left"
                                        Margin="0"
                                        Click="ClearFiltersButton_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                    <Button Content="✎"
                            Style="{StaticResource FlashcardEditorIconButtonStyle}"
                            Margin="0,0,8,8"
                            ToolTip="{Binding [RenameFlashcardSet], Source={StaticResource Loc}}"
                            Click="RenameSetButton_Click"/>
                    <Button Content="×"
                            Style="{StaticResource FlashcardEditorIconButtonStyle}"
                            Margin="0,0,8,8"
                            ToolTip="{Binding [DeleteFlashcardSet], Source={StaticResource Loc}}"
                            Click="DeleteSetButton_Click"/>
                    <ComboBox x:Name="SetSelectorComboBox"
                              Width="128"
                              Style="{StaticResource SetSelectorComboBoxStyle}"
                              ItemContainerStyle="{StaticResource SetSelectorComboBoxItemStyle}"
                              DisplayMemberPath="DisplayName"
                              Margin="0,0,8,8"
                              SelectionChanged="SetSelectorComboBox_SelectionChanged"/>
                    <Button Content="{Binding [CreateFlashcardSet], Source={StaticResource Loc}}"
                            Style="{StaticResource FlashcardToolbarButtonStyle}"
                            Click="CreateSetButton_Click"/>
                    <Button Content="{Binding [AddFlashcard], Source={StaticResource Loc}}"
                            Style="{StaticResource FlashcardToolbarPrimaryButtonStyle}"
                            Click="AddFlashcardButton_Click"/>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4"
              Margin="20,0,20,0">
            <Border x:Name="FlashcardsGridViewBorder"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Background="{DynamicResource CardBackground}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="14">
                    <ItemsControl x:Name="FlashcardsItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="300"
                                        Height="210"
                                        Margin="0,0,14,14"
                                        Padding="16"
                                        Background="{DynamicResource WindowBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        MouseLeftButtonUp="FlashcardCard_MouseLeftButtonUp"
                                        Cursor="Hand">
                                    <Border.ContextMenu>
                                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                            <MenuItem Header="{Binding [MoveToSet], Source={StaticResource Loc}}"
                                                      Click="MoveToSetMenuItem_Click"/>
                                            <MenuItem Header="{Binding [AddFlashcardToSet], Source={StaticResource Loc}}"
                                                      Click="AddFlashcardToSetMenuItem_Click"/>
                                            <Separator/>
                                            <MenuItem Header="{Binding [Edit], Source={StaticResource Loc}}"
                                            Click="EditFlashcardMenuItem_Click"/>
                                            <Separator/>
                                            <MenuItem Header="{Binding [Delete], Source={StaticResource Loc}}"
                                            Click="DeleteFlashcardMenuItem_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15"/>
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextColorSecondary}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="{Binding [FlashcardSideQuestion], Source={StaticResource Loc}}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsFlipped}" Value="True">
                                                                <Setter Property="Text" Value="{Binding [FlashcardSideAnswer], Source={StaticResource Loc}}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right">
                                                <Border Padding="8,3"
                                                        Background="{DynamicResource SelectionBackground}"
                                                        CornerRadius="6"
                                                        MaxWidth="160"
                                                        Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding Category}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource TextColorSecondary}"/>
                                                </Border>
                                                <Button Content="✎"
                                                        Width="26"
                                                        Height="24"
                                                        Margin="6,0,0,0"
                                                        Padding="0"
                                                        Style="{StaticResource FlashcardSearchIconButtonStyle}"
                                                        ToolTip="{Binding [Edit], Source={StaticResource Loc}}"
                                                        Click="EditFlashcardButton_Click"/>
                                                <Button Content="⇄"
                                                        Width="26"
                                                        Height="24"
                                                        Margin="6,0,0,0"
                                                        Padding="0"
                                                        Style="{StaticResource FlashcardSearchIconButtonStyle}"
                                                        ToolTip="{Binding [MoveToSet], Source={StaticResource Loc}}"
                                                        Click="MoveFlashcardButton_Click"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Grid.Row="1"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextColor}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Question}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFlipped}" Value="True">
                                                            <Setter Property="Text" Value="{Binding Answer}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding [FlashcardsTapHint], Source={StaticResource Loc}}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextColorSecondary}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border x:Name="StudyModeViewBorder"
                    Visibility="Collapsed"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Background="{DynamicResource CardBackground}"
                    Padding="14,12,14,10">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,0,12"
                                HorizontalAlignment="Center">
                        <Border x:Name="StudyModeProgressTrack"
                                Width="240"
                            Height="4"
                            Background="#D8DCE6"
                            CornerRadius="2"
                            ToolTipService.ShowDuration="5000"
                            ToolTipService.InitialShowDelay="250">
                            <Border x:Name="StudyModeProgressFill"
                                HorizontalAlignment="Left"
                                Width="0"
                                Background="#10B981"
                                CornerRadius="2"/>
                        </Border>
                        <TextBlock x:Name="StudyModeProgressText"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColorSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                        <TextBlock x:Name="StudyModeCompletionText"
                               Visibility="Collapsed"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#10B981"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                        </StackPanel>

                    <Border x:Name="StudyModeCard"
                            Grid.Row="1"
                            MinWidth="320"
                            Height="230"
                            MaxWidth="620"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0,4,0,14"
                            Padding="18"
                            Background="{DynamicResource WindowBackground}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="12"
                            MouseLeftButtonUp="StudyModeCard_MouseLeftButtonUp"
                            Cursor="Hand">
                        <Border.RenderTransform>
                            <TranslateTransform/>
                        </Border.RenderTransform>

                        <Border.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                <MenuItem Header="{Binding [MoveToSet], Source={StaticResource Loc}}"
                                          Click="MoveToSetMenuItem_Click"/>
                                <MenuItem Header="{Binding [AddFlashcardToSet], Source={StaticResource Loc}}"
                                          Click="AddFlashcardToSetMenuItem_Click"/>
                                <Separator/>
                                <MenuItem Header="{Binding [Edit], Source={StaticResource Loc}}"
                      Click="EditFlashcardMenuItem_Click"/>
                                <Separator/>
                                <MenuItem Header="{Binding [Delete], Source={StaticResource Loc}}"
                      Click="DeleteFlashcardMenuItem_Click"/>
                            </ContextMenu>
                        </Border.ContextMenu>

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.18"/>
                        </Border.Effect>

                        <Grid MaxWidth="570">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0"
                                            Orientation="Horizontal"
                                            VerticalAlignment="Top"
                                            Margin="0,0,12,0">
                                    <TextBlock FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextColorSecondary}"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{Binding [FlashcardSideQuestion], Source={StaticResource Loc}}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFlipped}" Value="True">
                                                        <Setter Property="Text" Value="{Binding [FlashcardSideAnswer], Source={StaticResource Loc}}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Border Padding="8,3"
                                            Margin="10,0,0,0"
                                            Background="{DynamicResource SelectionBackground}"
                                            CornerRadius="6"
                                            MaxWidth="210"
                                            Visibility="{Binding HasCategory, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding Category}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{DynamicResource TextColorSecondary}"/>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top">
                                    <Button Content="⇄"
                                            Width="26"
                                            Height="24"
                                            Margin="0,0,8,0"
                                            Padding="0"
                                            Style="{StaticResource FlashcardSearchIconButtonStyle}"
                                            ToolTip="{Binding [MoveToSet], Source={StaticResource Loc}}"
                                            Click="MoveStudyModeFlashcardButton_Click"/>
                                    <Grid>
                                    <Border Padding="8,4"
                                            Background="#10B981"
                                            CornerRadius="6"
                                            Visibility="{Binding IsKnown, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding [Known], Source={StaticResource Loc}}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"/>
                                    </Border>

                                    <Border Padding="8,4"
                                            Background="#F59E0B"
                                            CornerRadius="6"
                                            Visibility="{Binding IsUnknown, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding [Unknown], Source={StaticResource Loc}}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"/>
                                    </Border>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Margin="0,12,0,0">
                                <TextBlock TextWrapping="Wrap"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Question}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsFlipped}" Value="True">
                                                    <Setter Property="Text" Value="{Binding Answer}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </ScrollViewer>

                            <TextBlock Grid.Row="2"
                   Text="{Binding [FlashcardsTapHint], Source={StaticResource Loc}}"
                   FontSize="11"
                   Foreground="{DynamicResource TextColorSecondary}"
                   HorizontalAlignment="Right"
                   Margin="0,12,0,0"/>
                        </Grid>
                    </Border>

                    <WrapPanel Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,10,0,0">
                        <Button x:Name="StudyModePreviousButton"
            Content="{Binding [StudyModePrevious], Source={StaticResource Loc}}"
            Style="{StaticResource DialogSecondaryButtonStyle}"
            MinWidth="120"
            Margin="5,0,5,8"
            Click="StudyModePreviousButton_Click"/>
                        <Button x:Name="StudyModeNextButton"
            Content="{Binding [StudyModeNext], Source={StaticResource Loc}}"
            Style="{StaticResource DialogSecondaryButtonStyle}"
            MinWidth="120"
            Margin="5,0,5,8"
            Click="StudyModeNextButton_Click"/>

                        <Button x:Name="StudyModeMarkKnownButton"
            Content="{Binding [Known], Source={StaticResource Loc}}"
            Style="{StaticResource DialogSecondaryButtonStyle}"
            MinWidth="140"
            Margin="5,0,5,8"
            Background="#10B981"
            BorderBrush="#10B981"
            Foreground="White"
            Click="StudyModeMarkKnownButton_Click"/>

                        <Button x:Name="StudyModeMarkUnknownButton"
            Content="{Binding [Unknown], Source={StaticResource Loc}}"
            Style="{StaticResource DialogSecondaryButtonStyle}"
            MinWidth="160"
            Margin="5,0,5,8"
            Background="#F59E0B"
            BorderBrush="#F59E0B"
            Foreground="White"
            Click="StudyModeMarkUnknownButton_Click"/>
                    </WrapPanel>
                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="6"
                Margin="20,0,20,12"
                Padding="10,10,10,2"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="10">
            <WrapPanel Orientation="Horizontal"
                       HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal" 
                            VerticalAlignment="Center"
                            Margin="0,0,16,8">
                    <TextBlock Text="{Binding [FlashcardFlipSpeed], Source={StaticResource Loc}}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource TextColor}"
                               Margin="0,0,8,0"/>
                    <Slider x:Name="FlipSpeedSlider"
                            Width="120"
                            Minimum="100"
                            Maximum="1000"
                            Value="300"
                            TickPlacement="BottomRight"
                            TickFrequency="100"
                            IsSnapToTickEnabled="True"
                            Height="20"
                            VerticalAlignment="Center"
                            Margin="0,0,8,0"/>
                    <TextBlock VerticalAlignment="Center"
                               FontSize="12"
                               Foreground="{DynamicResource TextColorSecondary}"
                               MinWidth="45">
                        <Run Text="{Binding ElementName=FlipSpeedSlider, Path=Value}"/>
                        <Run Text="ms"/>
                    </TextBlock>
                </StackPanel>
                <Button Content="{Binding [FlashcardsShowQuestions], Source={StaticResource Loc}}"
                        Style="{StaticResource FlashcardToolbarButtonStyle}"
                        MinWidth="150"
                        Click="ShowQuestionsButton_Click"/>
                <Button Content="{Binding [FlashcardsShowAnswers], Source={StaticResource Loc}}"
                        Style="{StaticResource FlashcardToolbarButtonStyle}"
                        MinWidth="150"
                        Click="ShowAnswersButton_Click"/>
                <Button x:Name="ShuffleModeButton"
                        Style="{StaticResource FlashcardToolbarButtonStyle}"
                        MinWidth="110"
                        Click="ShuffleModeButton_Click"/>
                <Button x:Name="StartStudyModeButton"
                        Content="{Binding [StudyModeStart], Source={StaticResource Loc}}"
                        Style="{StaticResource FlashcardToolbarButtonStyle}"
                        MinWidth="140"
                        Click="StartStudyModeButton_Click"/>
                <Button Content="{Binding [Save], Source={StaticResource Loc}}"
                        Style="{StaticResource FlashcardToolbarPrimaryButtonStyle}"
                        MinWidth="110"
                        Click="SaveButton_Click"/>
                <Button Content="{Binding [Close], Source={StaticResource Loc}}"
                        Style="{StaticResource FlashcardToolbarButtonStyle}"
                        MinWidth="110"
                        Click="CloseButton_Click"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
