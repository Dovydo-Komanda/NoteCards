<Window x:Class="NoteCards.Views.FlashcardsPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [FlashcardsPreviewTitle], Source={StaticResource Loc}}"
        Height="620"
        Width="980"
        MinHeight="460"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <Window.Resources>
        <ControlTemplate x:Key="SetSelectorToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="ComboBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1"
                               Text="▾"
                               FontSize="11"
                               Foreground="{TemplateBinding Foreground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                    <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="ComboBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                    <Setter TargetName="ComboBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="SetSelectorComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Template="{StaticResource SetSelectorToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}"/>
                            <TextBlock IsHitTestVisible="False"
                                       Text="{Binding SelectedItem.DisplayName, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=''}"
                                       Margin="10,0,24,0"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="180">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SetSelectorComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CreateSetButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{Binding [FlashcardsPreviewTitle], Source={StaticResource Loc}}"
                   FontSize="22"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextColor}"/>

        <TextBlock Grid.Row="2"
                   x:Name="ModelInfoText"
                   Foreground="{DynamicResource TextColorSecondary}"
                   FontSize="13"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="{Binding [FlashcardsTapHint], Source={StaticResource Loc}}"
                       Foreground="{DynamicResource TextColorSecondary}"
                       FontSize="13"
                       VerticalAlignment="Center"/>

                        <StackPanel Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                    <ComboBox x:Name="SetSelectorComboBox"
                                                    Width="148"
                          Style="{StaticResource SetSelectorComboBoxStyle}"
                                                    ItemContainerStyle="{StaticResource SetSelectorComboBoxItemStyle}"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="SetSelectorComboBox_SelectionChanged"/>
                    <Button Content="{Binding [CreateFlashcardSet], Source={StaticResource Loc}}"
                        Style="{StaticResource CreateSetButtonStyle}"
                                                MinWidth="98"
                                                Margin="8,0,0,0"
                        Click="CreateSetButton_Click"/>
                        </StackPanel>
        </Grid>

        <Grid Grid.Row="6">
            <Border x:Name="FlashcardsGridViewBorder"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Background="{DynamicResource CardBackground}">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="14">
                    <ItemsControl x:Name="FlashcardsItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel IsItemsHost="True"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="300"
                                        Height="210"
                                        Margin="0,0,14,14"
                                        Padding="16"
                                        Background="{DynamicResource WindowBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        MouseLeftButtonUp="FlashcardCard_MouseLeftButtonUp"
                                        Cursor="Hand">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{Binding [MoveToSet], Source={StaticResource Loc}}"
                                                      SubmenuOpened="MoveToSetMenuItem_SubmenuOpened"/>
                                            <Separator/>
                                            <MenuItem Header="{Binding [Edit], Source={StaticResource Loc}}"
                                            Click="EditFlashcardMenuItem_Click"/>
                                            <Separator/>
                                            <MenuItem Header="{Binding [Delete], Source={StaticResource Loc}}"
                                            Click="DeleteFlashcardMenuItem_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15"/>
                                    </Border.Effect>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        
                                        <TextBlock FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextColorSecondary}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding [FlashcardSideQuestion], Source={StaticResource Loc}}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFlipped}" Value="True">
                                                            <Setter Property="Text" Value="{Binding [FlashcardSideAnswer], Source={StaticResource Loc}}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Row="1"
                                                   TextWrapping="Wrap"
                                                   VerticalAlignment="Center"
                                                   FontSize="16"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextColor}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Question}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsFlipped}" Value="True">
                                                            <Setter Property="Text" Value="{Binding Answer}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding [FlashcardsTapHint], Source={StaticResource Loc}}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextColorSecondary}"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Border x:Name="StudyModeViewBorder"
                    Visibility="Collapsed"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Background="{DynamicResource CardBackground}"
                    Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="StudyModeProgressText"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColorSecondary}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,12"/>

                    <Border x:Name="StudyModeCard"
        Grid.Row="1"
        Width="420"
        Height="260"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Padding="20"
        Background="{DynamicResource WindowBackground}"
        BorderBrush="{DynamicResource BorderColor}"
        BorderThickness="1"
        CornerRadius="12"
        MouseLeftButtonUp="StudyModeCard_MouseLeftButtonUp"
        Cursor="Hand">

                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{Binding [MoveToSet], Source={StaticResource Loc}}"
                                          SubmenuOpened="MoveToSetMenuItem_SubmenuOpened"/>
                                <Separator/>
                                <MenuItem Header="{Binding [Edit], Source={StaticResource Loc}}"
                      Click="EditFlashcardMenuItem_Click"/>
                                <Separator/>
                                <MenuItem Header="{Binding [Delete], Source={StaticResource Loc}}"
                      Click="DeleteFlashcardMenuItem_Click"/>
                            </ContextMenu>
                        </Border.ContextMenu>

                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.18"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Padding="8,4"
                Background="#10B981"
                CornerRadius="6"
                Visibility="{Binding IsKnown, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding [FlashcardKnownStatus], Source={StaticResource Loc}}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="White"/>
                            </Border>

                            <Border Grid.Row="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Padding="8,4"
                Background="#F59E0B"
                CornerRadius="6"
                Visibility="{Binding IsUnknown, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding [FlashcardUnknownStatus], Source={StaticResource Loc}}"
                       FontSize="11"
                       FontWeight="SemiBold"
                       Foreground="White"/>
                            </Border>

                            <TextBlock FontSize="12"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextColorSecondary}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding [FlashcardSideQuestion], Source={StaticResource Loc}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFlipped}" Value="True">
                                                <Setter Property="Text" Value="{Binding [FlashcardSideAnswer], Source={StaticResource Loc}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Grid.Row="1"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextColor}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="{Binding Question}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFlipped}" Value="True">
                                                <Setter Property="Text" Value="{Binding Answer}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <TextBlock Grid.Row="2"
                   Text="{Binding [FlashcardsTapHint], Source={StaticResource Loc}}"
                   FontSize="11"
                   Foreground="{DynamicResource TextColorSecondary}"
                   HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,16,0,0">
                        <Button x:Name="StudyModePreviousButton"
            Content="{Binding [StudyModePrevious], Source={StaticResource Loc}}"
            Style="{StaticResource DialogSecondaryButtonStyle}"
            MinWidth="120"
            Click="StudyModePreviousButton_Click"/>
                        <Button x:Name="StudyModeNextButton"
            Content="{Binding [StudyModeNext], Source={StaticResource Loc}}"
            Style="{StaticResource DialogSecondaryButtonStyle}"
            MinWidth="120"
            Margin="10,0,0,0"
            Click="StudyModeNextButton_Click"/>

                        <Button x:Name="StudyModeMarkKnownButton"
            Content="{Binding [MarkAsKnown], Source={StaticResource Loc}}"
            Style="{StaticResource DialogSecondaryButtonStyle}"
            MinWidth="140"
            Margin="10,0,0,0"
            Background="#10B981"
            BorderBrush="#10B981"
            Foreground="White"
            Click="StudyModeMarkKnownButton_Click"/>

                        <Button x:Name="StudyModeMarkUnknownButton"
            Content="{Binding [MarkAsUnknown], Source={StaticResource Loc}}"
            Style="{StaticResource DialogSecondaryButtonStyle}"
            MinWidth="160"
            Margin="10,0,0,0"
            Background="#F59E0B"
            BorderBrush="#F59E0B"
            Foreground="White"
            Click="StudyModeMarkUnknownButton_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="8"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <StackPanel Orientation="Horizontal" 
                        VerticalAlignment="Center"
                        Margin="0,0,15,0">
                <TextBlock Text="{Binding [FlashcardFlipSpeed], Source={StaticResource Loc}}"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="{DynamicResource TextColor}"
                           Margin="0,0,8,0"/>
                <Slider x:Name="FlipSpeedSlider"
                        Width="120"
                        Minimum="100"
                        Maximum="1000"
                        TickPlacement="BottomRight"
                        TickFrequency="100"
                        IsSnapToTickEnabled="True"
                        Height="20"
                        VerticalAlignment="Center"
                        Margin="0,0,8,0"/>
                <TextBlock VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextColorSecondary}"
                           MinWidth="45">
                    <Run Text="{Binding ElementName=FlipSpeedSlider, Path=Value}"/>
                    <Run Text="ms"/>
                </TextBlock>
            </StackPanel>
            <Button Content="{Binding [FlashcardsShowQuestions], Source={StaticResource Loc}}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    MinWidth="170"
                    Click="ShowQuestionsButton_Click"/>
            <Button Content="{Binding [FlashcardsShowAnswers], Source={StaticResource Loc}}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    MinWidth="170"
                    Margin="10,0,0,0"
                    Click="ShowAnswersButton_Click"/>
            <Button x:Name="StartStudyModeButton"
                    Content="{Binding [StudyModeStart], Source={StaticResource Loc}}"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    MinWidth="145"
                    Margin="10,0,0,0"
                    Click="StartStudyModeButton_Click"/>
            <Button Content="{Binding [Close], Source={StaticResource Loc}}"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    MinWidth="120"
                    Margin="10,0,0,0"
                    Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
