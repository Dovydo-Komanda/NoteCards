<Window x:Class="NoteCards.Views.SelectNoteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Link Note to Flashcard"
        MinHeight="400"
        Height="500"
        Width="500"
        MinWidth="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style x:Key="NoteListItemStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="14"
            Padding="16"
            Background="{DynamicResource CardBackground}"
            BorderBrush="{DynamicResource BorderColor}"
            BorderThickness="1"
            CornerRadius="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="Select a note to link to this flashcard"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"
                       Margin="0,0,0,12"/>

            <Border Grid.Row="1"
                    Height="36"
                    Padding="10,0"
                    Background="{DynamicResource WindowBackground}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Margin="0,0,0,12">
                <DockPanel LastChildFill="True">
                    <TextBlock Text="⌕"
                               Foreground="{DynamicResource TextColorSecondary}"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"
                               FontSize="13"/>
                    <TextBox x:Name="SearchTextBox"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource TextColor}"
                             CaretBrush="{DynamicResource TextColor}"
                             VerticalContentAlignment="Center"
                             TextChanged="SearchTextBox_TextChanged"
                             Padding="0,8"/>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Row="2"
                          VerticalScrollBarVisibility="Auto"
                          Margin="0,0,0,12">
                <ItemsControl x:Name="NotesItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource NoteListItemStyle}"
                                    MouseLeftButtonUp="NoteItem_MouseLeftButtonUp">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextColor}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Content}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextColorSecondary}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               MaxHeight="34"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cancel"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        MinWidth="84"
                        Padding="14,7"
                        Margin="0,0,8,0"
                        Click="CancelButton_Click"/>
                <Button x:Name="SelectButton"
                        Content="Select"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        MinWidth="84"
                        Padding="14,7"
                        IsEnabled="False"
                        Click="SelectButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>