<Window x:Class="NoteCards.Views.EditFlashcardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [EditFlashcard], Source={StaticResource Loc}}"
        Height="560"
        Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Background="#66000000">
        <Grid.Resources>
            <Style x:Key="FlashcardEditorInputStyle" TargetType="TextBox">
                <Setter Property="Padding" Value="12"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
                <Setter Property="CaretBrush" Value="{DynamicResource TextColor}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="InputBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                    <Setter TargetName="InputBorder" Property="BorderBrush" Value="#4A6EE0"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="FlashcardDialogSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
                <Setter Property="Padding" Value="20,10"/>
                <Setter Property="MinWidth" Value="110"/>
            </Style>

            <Style x:Key="FlashcardDialogPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButtonStyle}">
                <Setter Property="Padding" Value="20,10"/>
                <Setter Property="MinWidth" Value="110"/>
            </Style>
        </Grid.Resources>

        <Border x:Name="DialogCard"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="480">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="32" ShadowDepth="4"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock x:Name="DialogTitleTextBlock"
                           Grid.Row="0"
                           Text="{Binding DialogTitle}"
                           FontSize="22"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}"
                           Margin="0,0,0,6"/>

                <TextBlock x:Name="DialogHintTextBlock"
                           Grid.Row="0"
                           Text="{Binding DialogHint}"
                           FontSize="12"
                           Foreground="{DynamicResource TextColorSecondary}"
                           Margin="0,34,0,20"/>

                <!-- Question -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding [FlashcardSideQuestion], Source={StaticResource Loc}}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <TextBox Grid.Row="2"
                             x:Name="QuestionTextBox"
                             Height="80"
                             Style="{StaticResource FlashcardEditorInputStyle}"
                             VerticalContentAlignment="Top"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>

                <!-- Answer -->
                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding [FlashcardSideAnswer], Source={StaticResource Loc}}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <TextBox Grid.Row="2"
                             x:Name="AnswerTextBox"
                             MinHeight="120"
                             Style="{StaticResource FlashcardEditorInputStyle}"
                             VerticalContentAlignment="Top"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"/>
                </Grid>

                <!-- Category -->
                <Grid Grid.Row="3" Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding [FlashcardCategory], Source={StaticResource Loc}}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <TextBox Grid.Row="2"
                             x:Name="CategoryTextBox"
                             Height="36"
                             Padding="12,8"
                             Style="{StaticResource FlashcardEditorInputStyle}"/>
                </Grid>

                <!-- Buttons -->
                <StackPanel Grid.Row="4"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,0">
                    <Button Content="{Binding [Cancel], Source={StaticResource Loc}}"
                            Style="{StaticResource FlashcardDialogSecondaryButtonStyle}"
                            Click="CancelButton_Click"/>
                    <Button Content="{Binding [Save], Source={StaticResource Loc}}"
                            Margin="12,0,0,0"
                            Style="{StaticResource FlashcardDialogPrimaryButtonStyle}"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
