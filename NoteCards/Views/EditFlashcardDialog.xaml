<Window x:Class="NoteCards.Views.EditFlashcardDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [EditFlashcard], Source={StaticResource Loc}}"
        Height="420"
        Width="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Background="#66000000">
        <Border Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="480">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="32" ShadowDepth="4"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0"
                           Text="{Binding [EditFlashcard], Source={StaticResource Loc}}"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextColor}"
                           Margin="0,0,0,20"/>

                <!-- Question -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding [FlashcardSideQuestion], Source={StaticResource Loc}}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <TextBox Grid.Row="2"
                             x:Name="QuestionTextBox"
                             Height="80"
                             Padding="12"
                             FontSize="14"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource WindowBackground}"
                             BorderBrush="{DynamicResource BorderColor}"
                             BorderThickness="1"
                             Foreground="{DynamicResource TextColor}"/>
                </Grid>

                <!-- Answer -->
                <Grid Grid.Row="2" Margin="0,0,0,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0"
                               Text="{Binding [FlashcardSideAnswer], Source={StaticResource Loc}}"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <TextBox Grid.Row="2"
                             x:Name="AnswerTextBox"
                             Height="100"
                             Padding="12"
                             FontSize="14"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource WindowBackground}"
                             BorderBrush="{DynamicResource BorderColor}"
                             BorderThickness="1"
                             Foreground="{DynamicResource TextColor}"/>
                </Grid>

                <!-- Buttons -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,0,0,20">
                    <Button Content="{Binding [Cancel], Source={StaticResource Loc}}"
                            Padding="20,10"
                            MinWidth="110"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            Foreground="{DynamicResource TextColor}"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="CancelButton_Click"/>
                    <Button Content="{Binding [Save], Source={StaticResource Loc}}"
                            Padding="20,10"
                            MinWidth="110"
                            Margin="12,0,0,0"
                            Background="#4A6EE0"
                            BorderBrush="#4A6EE0"
                            BorderThickness="1"
                            Foreground="White"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Cursor="Hand"
                            Click="SaveButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>