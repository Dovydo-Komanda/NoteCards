<Window x:Class="NoteCards.Views.QuizAttemptHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Quiz Attempt History"
        Height="600"
        Width="750"
        MinHeight="400"
        MinWidth="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="20,16">
            <TextBlock Text="Saved Quiz Attempts"
                       FontSize="20"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextColor}"/>
        </Border>

        <ScrollViewer Grid.Row="1"
                      Margin="20,16,20,8"
                      VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="AttemptsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,10"
                                Padding="16,14"
                                CornerRadius="10"
                                Background="{DynamicResource CardBackground}"
                                BorderThickness="1"
                                Cursor="Hand"
                                MouseLeftButtonUp="AttemptCard_MouseLeftButtonUp">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Passed}" Value="True">
                                            <Setter Property="BorderBrush" Value="#10B981"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Passed}" Value="False">
                                            <Setter Property="BorderBrush" Value="#DC2626"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.07"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding QuizTitle}"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextColor}"/>
                                    <TextBlock Text="{Binding DateDisplay}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextColorSecondary}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Padding="12,6"
                                        CornerRadius="8"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Passed}" Value="True">
                                                    <Setter Property="Background" Value="#ECFDF5"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Passed}" Value="False">
                                                    <Setter Property="Background" Value="#FEF2F2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="13"
                                               FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Passed}" Value="True">
                                                        <Setter Property="Text" Value="✓ PASS"/>
                                                        <Setter Property="Foreground" Value="#065F46"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Passed}" Value="False">
                                                        <Setter Property="Text" Value="✗ FAIL"/>
                                                        <Setter Property="Foreground" Value="#991B1B"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="20,12"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,1,0,0"
                Background="{DynamicResource CardBackground}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Clear All"
                        Padding="14,8"
                        Margin="0,0,10,0"
                        Click="ClearAllButton_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}"/>
                    </Button.Style>
                </Button>
                <Button Content="Close"
                        Padding="14,8"
                        Click="CloseButton_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}"/>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>