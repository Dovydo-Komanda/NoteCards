<Window x:Class="NoteCards.Views.GroupDisbandConfirmationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DisbandGroup"
        Height="360"
        Width="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style x:Key="OrangeConfirmButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButtonStyle}">
            <Setter Property="Background" Value="#F59E0B"/>
            <Setter Property="BorderBrush" Value="#D97706"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#D97706"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#B45309"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#B45309"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#92400E"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#66000000">
        <Border x:Name="DialogCard"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="16"
                Padding="32,28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="520">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.25" BlurRadius="32" ShadowDepth="4"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Width="48"
                            Height="48"
                            Background="#FFF7ED"
                            CornerRadius="12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top">
                        <TextBlock Text="⚠️"
                                   FontSize="22"
                                   Foreground="#D97706"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,4,0,0">
                        <TextBlock Text="{Binding TitleText}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <TextBlock Grid.Row="1"
                           Text="{Binding MessageText}"
                           FontSize="14"
                           Foreground="{DynamicResource TextColor}"
                           Opacity="0.85"
                           TextWrapping="Wrap"
                           Margin="0,0,0,18"
                           LineHeight="20"/>

                <StackPanel Grid.Row="2"
                            HorizontalAlignment="Stretch">
                    <Button Content="{Binding CancelText}"
                            Style="{StaticResource DialogSecondaryButtonStyle}"
                            Padding="18,10"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,10"
                            Click="CancelButton_Click"/>

                    <Button Content="{Binding KeepNotesText}"
                            Style="{StaticResource OrangeConfirmButtonStyle}"
                            Padding="18,10"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,10"
                            Click="KeepNotesButton_Click"/>

                    <Button Content="{Binding DeleteNotesText}"
                            Style="{StaticResource DialogDangerButtonStyle}"
                            Padding="18,10"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            Click="DeleteNotesButton_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
