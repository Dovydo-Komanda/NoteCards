<Window x:Class="NoteCards.Views.QuizPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding [QuizPreviewTitle], Source={StaticResource Loc}}"
        Height="730"
        Width="980"
        MinHeight="650"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}">
    <Window.Resources>
        <Style x:Key="QuizToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="QuizToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButtonStyle}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="QuizOptionButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OptionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
                    <Setter Property="BorderBrush" Value="#3F6FE8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCorrectAfterSubmit}" Value="True">
                    <Setter Property="Background" Value="#ECFDF5"/>
                    <Setter Property="BorderBrush" Value="#10B981"/>
                    <Setter Property="Foreground" Value="#065F46"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsIncorrectSelectedAfterSubmit}" Value="True">
                    <Setter Property="Background" Value="#FEF2F2"/>
                    <Setter Property="BorderBrush" Value="#DC2626"/>
                    <Setter Property="Foreground" Value="#991B1B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,14,0"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,4">
                    <TextBox x:Name="TitleTextBox"
                             FontSize="20"
                             FontWeight="SemiBold"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource TextColor}"
                             CaretBrush="{DynamicResource TextColor}"
                             VerticalAlignment="Center"
                             ToolTip="{Binding [QuizTitleHint], Source={StaticResource Loc}}"/>
                </Border>

                <Border x:Name="AiGeneratedInfoBadge"
                        Grid.Column="1"
                        Width="30"
                        Height="30"
                        CornerRadius="15"
                        Background="{DynamicResource IconButtonBackground}"
                        BorderBrush="{DynamicResource IconButtonBorder}"
                        BorderThickness="1"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTipService.InitialShowDelay="180"
                        Visibility="Collapsed">
                    <TextBlock Text="🤖"
                               FontSize="14"
                               Foreground="{DynamicResource TextColorSecondary}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="20,12,20,10"
                Padding="12,9"
                CornerRadius="10"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="QuestionCountTextBlock"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <TextBlock x:Name="AnsweredCountTextBlock"
                               Margin="16,0,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource TextColorSecondary}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        x:Name="ScoreBadge"
                        Padding="10,5"
                        CornerRadius="8"
                        Background="{DynamicResource SelectionBackground}"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ScoreTextBlock"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2"
                      Margin="20,0,20,10"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="QuestionsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12"
                                Padding="16"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0"
                                      Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding HeaderText}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextColorSecondary}"/>

                                    <Border Grid.Column="1"
                                            Padding="8,4"
                                            CornerRadius="7"
                                            Background="{Binding ResultBackground}"
                                            Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding ResultText}"
                                                   FontSize="11"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"/>
                                    </Border>
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding Question}"
                                           TextWrapping="Wrap"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}"
                                           Margin="0,0,0,12"/>

                                <ItemsControl Grid.Row="2"
                                              ItemsSource="{Binding Options}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource QuizOptionButtonStyle}"
                                                    Margin="0,0,0,8"
                                                    Click="OptionButton_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding MarkerText}"
                                                               FontSize="14"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Top"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Text}"
                                                               TextWrapping="Wrap"
                                                               FontSize="13"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Grid.Row="3"
                                        Margin="0,4,0,0"
                                        Padding="10,8"
                                        Background="{DynamicResource SelectionBackground}"
                                        CornerRadius="8"
                                        Visibility="{Binding HasVisibleExplanation, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ExplanationText}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextColorSecondary}"/>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3"
                Margin="20,0,20,12"
                Padding="10,10,10,2"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="10">
            <WrapPanel Orientation="Horizontal"
                       HorizontalAlignment="Right">
                <Button x:Name="CheckAnswersButton"
                        Content="{Binding [QuizCheckAnswers], Source={StaticResource Loc}}"
                        Style="{StaticResource QuizToolbarPrimaryButtonStyle}"
                        Click="CheckAnswersButton_Click"/>
                <Button x:Name="ResetAnswersButton"
                        Content="{Binding [QuizResetAnswers], Source={StaticResource Loc}}"
                        Style="{StaticResource QuizToolbarButtonStyle}"
                        Click="ResetAnswersButton_Click"/>
                <Button Content="{Binding [Close], Source={StaticResource Loc}}"
                        Style="{StaticResource QuizToolbarButtonStyle}"
                        Click="CloseButton_Click"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
