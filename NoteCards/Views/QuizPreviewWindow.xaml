<Window x:Class="NoteCards.Views.QuizPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="QuizWindow"
        Title="{Binding [QuizPreviewTitle], Source={StaticResource Loc}}"
        Height="730"
        Width="980"
        MinHeight="650"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Closing="QuizPreviewWindow_Closing">
    <Window.Resources>
        <Style x:Key="QuizToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="LinkedNoteButtonStyle" TargetType="Button" BasedOn="{StaticResource QuizToolbarButtonStyle}">
            <Setter Property="Margin" Value="0,0,0,0"/>
            <Setter Property="MinWidth" Value="190"/>
            <Setter Property="MaxWidth" Value="320"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="LinkedNoteBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="LinkedNoteBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                                <Setter TargetName="LinkedNoteBorder" Property="BorderBrush" Value="#3F6FE8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="LinkedNoteBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                                <Setter TargetName="LinkedNoteBorder" Property="BorderBrush" Value="#3F6FE8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.65"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuizToolbarPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogPrimaryButtonStyle}">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="MinWidth" Value="130"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
        </Style>

        <Style x:Key="QuizOptionMoveButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogSecondaryButtonStyle}">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="28"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="4,0,0,0"/>
        </Style>

        <Style x:Key="QuizEditorTextBoxStyle" TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="EditorTextBoxBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="EditorTextBoxBorder" Property="BorderBrush" Value="#3F6FE8"/>
                            </Trigger>
                            <Trigger Property="IsReadOnly" Value="True">
                                <Setter Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="QuizEditorComboBoxToggleButtonTemplate" TargetType="ToggleButton">
            <Border x:Name="QuizEditorComboBorder"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8"
                    Padding="{TemplateBinding Padding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="1"
                               Text="▾"
                               FontSize="11"
                               Foreground="{TemplateBinding Foreground}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="QuizEditorComboBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                    <Setter TargetName="QuizEditorComboBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="QuizEditorComboBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                    <Setter TargetName="QuizEditorComboBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="QuizEditorComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Template="{StaticResource QuizEditorComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}"/>
                            <TextBlock IsHitTestVisible="False"
                                       Text="{TemplateBinding SelectionBoxItem}"
                                       Margin="10,0,30,0"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="180">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkedNoteComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource QuizEditorComboBoxStyle}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press"
                                          Template="{StaticResource QuizEditorComboBoxToggleButtonTemplate}"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Padding="{TemplateBinding Padding}"/>
                            <TextBlock IsHitTestVisible="False"
                                       Text="{Binding ElementName=QuizWindow, Path=LinkedNoteButtonText}"
                                       Margin="10,0,30,0"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                            <Popup x:Name="Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}">
                                    <ScrollViewer MaxHeight="180">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuizEditorComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuizOptionButtonStyle" TargetType="Button">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,9"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="OptionBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
                    <Setter Property="BorderBrush" Value="#3F6FE8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCorrectAfterSubmit}" Value="True">
                    <Setter Property="Background" Value="#ECFDF5"/>
                    <Setter Property="BorderBrush" Value="#10B981"/>
                    <Setter Property="Foreground" Value="#065F46"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsIncorrectSelectedAfterSubmit}" Value="True">
                    <Setter Property="Background" Value="#FEF2F2"/>
                    <Setter Property="BorderBrush" Value="#DC2626"/>
                    <Setter Property="Foreground" Value="#991B1B"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="0,0,0,1"
                Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,14,0"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TitleTextBox"
                                 Grid.Column="0"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{DynamicResource TextColor}"
                                 CaretBrush="{DynamicResource TextColor}"
                                 VerticalAlignment="Center"
                                 TextChanged="EditorField_TextChanged"
                                 ToolTip="{Binding [QuizTitleHint], Source={StaticResource Loc}}"/>
                        <TextBlock x:Name="EditedIndicatorText"
                                   Grid.Column="1"
                                   Text="{Binding [EditedIndicator], Source={StaticResource Loc}}"
                                   Margin="12,0,0,0"
                                   FontSize="12"
                                   FontStyle="Italic"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <StackPanel Margin="0,0,8,0">
                        <ComboBox ItemsSource="{Binding ElementName=QuizWindow, Path=NoteLinkOptions}"
                                  SelectedItem="{Binding ElementName=QuizWindow, Path=SelectedLinkedNote, Mode=TwoWay}"
                                  DisplayMemberPath="Title"
                                  MinWidth="140"
                                  MaxWidth="170"
                                  Margin="0,0,0,6"
                                  Style="{StaticResource LinkedNoteComboBoxStyle}"
                                  Visibility="{Binding ElementName=QuizWindow, Path=IsEditMode, Converter={StaticResource BoolToVis}}"
                                  SelectedValuePath="Id"
                                  ToolTip="{Binding [QuizLinkedNoteSelectorTooltip], Source={StaticResource Loc}}"/>
                        <Button x:Name="LinkedNoteButton"
                                Content="{Binding ElementName=QuizWindow, Path=LinkedNoteButtonText}"
                                Style="{StaticResource LinkedNoteButtonStyle}"
                                MinWidth="140"
                                MaxWidth="170"
                                Click="LinkedNoteButton_Click"
                                Visibility="{Binding ElementName=QuizWindow, Path=IsEditMode, Converter={StaticResource InverseBoolToVis}}"
                                ToolTip="{Binding ElementName=QuizWindow, Path=LinkedNoteButtonToolTip}"
                                TextOptions.TextFormattingMode="Display"/>
                    </StackPanel>

                    <Border x:Name="AiGeneratedInfoBadge"
                            Width="30"
                            Height="30"
                            CornerRadius="15"
                            Background="{DynamicResource IconButtonBackground}"
                            BorderBrush="{DynamicResource IconButtonBorder}"
                            BorderThickness="1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            ToolTipService.InitialShowDelay="180"
                            Visibility="Collapsed">
                        <TextBlock Text="🤖"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextColorSecondary}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Margin="20,12,20,10"
                Padding="12,9"
                CornerRadius="10"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="QuestionCountTextBlock"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                    <TextBlock x:Name="AnsweredCountTextBlock"
                               Margin="16,0,0,0"
                               FontSize="13"
                               Foreground="{DynamicResource TextColorSecondary}"/>
                </StackPanel>

                <Border Grid.Column="1"
                        x:Name="ScoreBadge"
                        Padding="10,5"
                        CornerRadius="8"
                        Background="{DynamicResource SelectionBackground}"
                        Visibility="Collapsed">
                    <TextBlock x:Name="ScoreTextBlock"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextColor}"/>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="2"
                      Margin="20,0,20,10"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl x:Name="QuestionsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,12"
                                Padding="16"
                                Background="{DynamicResource CardBackground}"
                                CornerRadius="12">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFocused}" Value="True">
                                            <Setter Property="BorderBrush" Value="#3F6FE8"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.08"/>
                            </Border.Effect>

                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Grid Grid.Row="0"
                                      Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding HeaderText}"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextColorSecondary}"/>

                                    <StackPanel Grid.Column="1"
                                                Orientation="Horizontal">
                                        <ComboBox Style="{StaticResource QuizEditorComboBoxStyle}"
                                                  MinWidth="150"
                                                  Margin="0,0,8,8"
                                                  Loaded="QuizTypeComboBox_Loaded"
                                                  SelectionChanged="QuizTypeComboBox_SelectionChanged"
                                                  Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                            <ComboBoxItem Style="{StaticResource QuizEditorComboBoxItemStyle}"
                                                          Tag="SingleChoice"
                                                          Content="{Binding [QuizTypeSingleChoice], Source={StaticResource Loc}}"/>
                                            <ComboBoxItem Style="{StaticResource QuizEditorComboBoxItemStyle}"
                                                          Tag="MultipleChoice"
                                                          Content="{Binding [QuizTypeMultipleChoice], Source={StaticResource Loc}}"/>
                                            <ComboBoxItem Style="{StaticResource QuizEditorComboBoxItemStyle}"
                                                          Tag="TrueFalse"
                                                          Content="{Binding [QuizTypeTrueFalse], Source={StaticResource Loc}}"/>
                                        </ComboBox>
                                        <Button Content="↑"
                                                Style="{StaticResource QuizToolbarButtonStyle}"
                                                MinWidth="34"
                                                Padding="0,4"
                                                ToolTip="{Binding [MoveQuestionUp], Source={StaticResource Loc}}"
                                                Click="MoveQuestionUpButton_Click"
                                                Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        <Button Content="↓"
                                                Style="{StaticResource QuizToolbarButtonStyle}"
                                                MinWidth="34"
                                                Padding="0,4"
                                                ToolTip="{Binding [MoveQuestionDown], Source={StaticResource Loc}}"
                                                Click="MoveQuestionDownButton_Click"
                                                Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        <Button Content="×"
                                                Style="{StaticResource QuizToolbarButtonStyle}"
                                                MinWidth="34"
                                                Padding="0,4"
                                                ToolTip="{Binding [DeleteQuestion], Source={StaticResource Loc}}"
                                                Click="DeleteQuestionButton_Click"
                                                Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                        <Border Padding="8,4"
                                                CornerRadius="7"
                                                Background="{Binding ResultBackground}"
                                                Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding ResultText}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Grid.Row="1"
                                           Text="{Binding Question}"
                                           TextWrapping="Wrap"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextColor}"
                                           Margin="0,0,0,12"
                                           Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}"/>

                                <TextBox Grid.Row="1"
                                         Text="{Binding Question, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         MinHeight="42"
                                         FontSize="16"
                                         FontWeight="SemiBold"
                                         Style="{StaticResource QuizEditorTextBoxStyle}"
                                         Margin="0,0,0,12"
                                         Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>

                                <ItemsControl Grid.Row="2"
                                              ItemsSource="{Binding Options}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource QuizOptionButtonStyle}"
                                                    Margin="0,0,0,8"
                                                    Click="OptionButton_Click">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding MarkerText}"
                                                               FontSize="14"
                                                                           FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                                               <CheckBox Grid.Column="1"
                                                                         IsChecked="{Binding IsCorrect, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                         Margin="0,0,8,0"
                                                                         VerticalAlignment="Center"
                                                                         ToolTip="{Binding [CorrectAnswer], Source={StaticResource Loc}}"
                                                                         Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                                               <TextBlock Grid.Column="2"
                                                               Text="{Binding Text}"
                                                               TextWrapping="Wrap"
                                                               FontSize="13"
                                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                               Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InverseBoolToVis}}"/>
                                                    <TextBox Grid.Column="2"
                                                             Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             TextWrapping="Wrap"
                                                             FontSize="13"
                                                             Style="{StaticResource QuizEditorTextBoxStyle}"
                                                             MinHeight="30"
                                                             Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                                                    <StackPanel Grid.Column="3"
                                                                Orientation="Horizontal"
                                                                Margin="6,0,0,0">
                                                        <StackPanel.Style>
                                                            <Style TargetType="StackPanel">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <MultiDataTrigger>
                                                                        <MultiDataTrigger.Conditions>
                                                                            <Condition Binding="{Binding Parent.CanReorderOptions}" Value="True"/>
                                                                            <Condition Binding="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True"/>
                                                                        </MultiDataTrigger.Conditions>
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </MultiDataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </StackPanel.Style>
                                                        <Button Content="↑"
                                                                Style="{StaticResource QuizOptionMoveButtonStyle}"
                                                                ToolTip="{Binding [MoveOptionUp], Source={StaticResource Loc}}"
                                                                Click="MoveOptionUpButton_Click"/>
                                                        <Button Content="↓"
                                                                Style="{StaticResource QuizOptionMoveButtonStyle}"
                                                                ToolTip="{Binding [MoveOptionDown], Source={StaticResource Loc}}"
                                                                Click="MoveOptionDownButton_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Grid.Row="3"
                                        Margin="0,4,0,0"
                                        Padding="10,8"
                                        Background="{DynamicResource SelectionBackground}"
                                        CornerRadius="8"
                                        Visibility="{Binding HasVisibleExplanation, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{Binding ExplanationText}"
                                               TextWrapping="Wrap"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextColorSecondary}"/>
                                </Border>

                                <Border Grid.Row="3"
                                        Margin="0,8,0,0"
                                        Padding="10,8"
                                        Background="{DynamicResource WindowBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Visibility="{Binding IsEditMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Button Content="{Binding [AddOption], Source={StaticResource Loc}}"
                                                Style="{StaticResource QuizToolbarButtonStyle}"
                                                HorizontalAlignment="Left"
                                                Click="AddOptionButton_Click"
                                                Visibility="{Binding CanAddOption, Converter={StaticResource BoolToVis}}"/>
                                        <TextBlock Text="{Binding [QuizExplanationLabel], Source={StaticResource Loc}}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextColorSecondary}"
                                                   Margin="0,4,0,6"/>
                                        <TextBox Text="{Binding Explanation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 MinHeight="38"
                                                 MaxHeight="72"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"
                                                 VerticalAlignment="Center"
                                                 ToolTip="{Binding [QuizExplanationHint], Source={StaticResource Loc}}"
                                                 Style="{StaticResource QuizEditorTextBoxStyle}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Border Grid.Row="3"
                Margin="20,0,20,12"
                Padding="10,10,10,2"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderColor}"
                BorderThickness="1"
                CornerRadius="10">
            <WrapPanel Orientation="Horizontal"
                       HorizontalAlignment="Right">
                <!-- Rasti šią vietą (WrapPanel su mygtukais) ir PRIEŠ StartQuizButton pridėti: -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,8">
                    <TextBlock Text="Time limit:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="TimeLimitComboBox" Width="120">
                        <ComboBoxItem Content="No limit" Tag="0"/>
                        <ComboBoxItem Content="1 min" Tag="60"/>
                        <ComboBoxItem Content="5 min" Tag="300"/>
                        <ComboBoxItem Content="10 min" Tag="600"/>
                        <ComboBoxItem Content="15 min" Tag="900"/>
                        <ComboBoxItem Content="30 min" Tag="1800"/>
                    </ComboBox>
                </StackPanel>
                <Button x:Name="StartQuizButton"
                Content="{Binding [QuizStartButton], Source={StaticResource Loc}}"
                Style="{StaticResource QuizToolbarPrimaryButtonStyle}"
                Background="#10B981"
                BorderBrush="#10B981"
                Foreground="White"
                Click="StartQuizButton_Click"
                ToolTip="{Binding [QuizStartButtonTooltip], Source={StaticResource Loc}}"/>
                <Button x:Name="FullscreenButton"
                        Content="⛶ Fullscreen"
                        Style="{StaticResource QuizToolbarButtonStyle}"
                        Click="FullscreenButton_Click"
                        ToolTip="Toggle Fullscreen (F11)"/>
                <Button x:Name="ExportButton"
                        Content="{Binding [Export], Source={StaticResource Loc}}"
                        Style="{StaticResource QuizToolbarButtonStyle}"
                        Click="ExportButton_Click"
                        ToolTip="{Binding [Export], Source={StaticResource Loc}}"/>
                <Button x:Name="ModeToggleButton"
                        Content="{Binding [EditQuiz], Source={StaticResource Loc}}"
                        Style="{StaticResource QuizToolbarButtonStyle}"
                        Click="ModeToggleButton_Click"/>
                <Button x:Name="CheckAnswersButton"
                        Content="{Binding [QuizCheckAnswers], Source={StaticResource Loc}}"
                        Style="{StaticResource QuizToolbarPrimaryButtonStyle}"
                        Click="CheckAnswersButton_Click"/>
                <Button x:Name="ResetAnswersButton"
                        Content="{Binding [QuizResetAnswers], Source={StaticResource Loc}}"
                        Style="{StaticResource QuizToolbarButtonStyle}"
                        Click="ResetAnswersButton_Click"/>
                <Button x:Name="AddQuestionButton"
                        Content="{Binding [AddQuestion], Source={StaticResource Loc}}"
                        Style="{StaticResource QuizToolbarButtonStyle}"
                        Click="AddQuestionButton_Click"/>
                <Button Content="{Binding [Save], Source={StaticResource Loc}}"
                        Style="{StaticResource QuizToolbarPrimaryButtonStyle}"
                        Click="SaveButton_Click"/>
                <Button Content="{Binding [Close], Source={StaticResource Loc}}"
                        Style="{StaticResource QuizToolbarButtonStyle}"
                        Click="CloseButton_Click"/>
            </WrapPanel>
        </Border>
    </Grid>
</Window>
