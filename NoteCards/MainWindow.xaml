                                                                                        </Border>
                                                                                        <StackPanel Grid.Column="1"
                                                                                                    Orientation="Horizontal"
                                                                                                    VerticalAlignment="Center"
                                                                                                    Margin="0,0,6,0">
                                                                                            <TextBlock Text="📌"
                                                                                                       FontSize="13"
                                                                                                       Margin="0,0,5,0"
                                                                                                       VerticalAlignment="Center"
                                                                                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"
