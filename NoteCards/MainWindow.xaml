                                                                <MenuItem Header="{Binding [Open], Source={StaticResource Loc}}"
                                                                Click="OpenQuizMenuItem_Click"/>
                                                                <MenuItem Header="{Binding [Duplicate], Source={StaticResource Loc}}"
                                                                Click="DuplicateQuizMenuItem_Click"/>
                                                                <MenuItem Header="{Binding [RemoveFromGroup], Source={StaticResource Loc}}"
                                                                          Visibility="{Binding Document.GroupId, Converter={StaticResource NullToVisibilityConverter}}"
                                                                          Click="RemoveQuizFromGroupMenuItem_Click"/>
                                                                <MenuItem Header="{Binding [CalendarAssignMenu], Source={StaticResource Loc}}"
                                                                          Click="ScheduleQuizMenuItem_Click"/>
                                                                <Separator/>
                                                                <MenuItem Header="{Binding [Pin], Source={StaticResource Loc}}"
                                                                          Click="ToggleQuizPinMenuItem_Click"
                                                                          Visibility="{Binding Document.IsPinned, Converter={StaticResource InverseBoolToVis}}"/>
                                                                <MenuItem Header="{Binding [Unpin], Source={StaticResource Loc}}"
                                                                          Click="ToggleQuizPinMenuItem_Click"
                                                                          Visibility="{Binding Document.IsPinned, Converter={StaticResource BoolToVis}}"/>
                                                                <Separator/>
                                                                <MenuItem Header="{Binding [Delete], Source={StaticResource Loc}}"
                                                                Click="DeleteQuizMenuItem_Click"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <Border x:Name="QuizCardBorder"
                                                                Background="{DynamicResource CardBackground}"
                                                                BorderBrush="{DynamicResource BorderColor}"
                                                                BorderThickness="1"
                                                                CornerRadius="14"
                                                                Padding="16"
                                                                Opacity="0"
                                                                RenderTransformOrigin="0.5,0.5">
                                                            <Border.RenderTransform>
                                                                <TransformGroup>
                                                                    <ScaleTransform ScaleX="0.88" ScaleY="0.88"/>
                                                                    <TranslateTransform Y="0"/>
                                                                </TransformGroup>
                                                            </Border.RenderTransform>
                                                            <Border.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                             From="0"
                                                                                             To="1"
                                                                                             Duration="0:0:0.25"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                                             From="0"
                                                                                             To="0"
                                                                                             Duration="0:0:0.25"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                                             From="0.88"
                                                                                             To="1"
                                                                                             Duration="0:0:0.32">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <BackEase EasingMode="EaseOut" Amplitude="0.25"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                                             From="0.88"
                                                                                             To="1"
                                                                                             Duration="0:0:0.32">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <BackEase EasingMode="EaseOut" Amplitude="0.25"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                                <EventTrigger RoutedEvent="MouseEnter">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="QuizCardBorder"
                                                                                             Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                                                             To="14"
                                                                                             Duration="0:0:0.18"/>
                                                                            <DoubleAnimation Storyboard.TargetName="QuizCardBorder"
                                                                                             Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                                                             To="0.18"
                                                                                             Duration="0:0:0.18"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                                             To="1.02"
                                                                                             Duration="0:0:0.18"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                                             To="1.02"
                                                                                             Duration="0:0:0.18"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                                <EventTrigger RoutedEvent="MouseLeave">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="QuizCardBorder"
                                                                                             Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                                                             To="8"
                                                                                             Duration="0:0:0.2"/>
                                                                            <DoubleAnimation Storyboard.TargetName="QuizCardBorder"
                                                                                             Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                                                             To="0.08"
                                                                                             Duration="0:0:0.2"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                                             To="1.0"
                                                                                             Duration="0:0:0.2"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                                             To="1.0"
                                                                                             Duration="0:0:0.2"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </Border.Triggers>
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="8" ShadowDepth="1" Direction="270"/>
                                                            </Border.Effect>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

                                                                <Grid>
																	<Grid.ColumnDefinitions>
																		<ColumnDefinition Width="Auto"/>
																		<ColumnDefinition Width="*"/>
																		<ColumnDefinition Width="Auto"/>
																	</Grid.ColumnDefinitions>
																	<Border Grid.Column="0"
																			Width="24"
																			Height="24"
																			Margin="0,0,6,0"
																			CornerRadius="12"
																			Background="{DynamicResource IconButtonBackground}"
																			BorderBrush="{DynamicResource IconButtonBorder}"
                                                                            BorderThickness="1"
                                                                            ToolTip="{Binding AiGeneratedTooltip}"
                                                                            Visibility="{Binding IsAiGenerated, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="🤖"
                                                                                   FontSize="13"
                                                                                   Foreground="{DynamicResource TextColorSecondary}"
																				   HorizontalAlignment="Center"
																				   VerticalAlignment="Center"/>
																	</Border>
																	<StackPanel Grid.Column="1"
                                                                                Orientation="Horizontal"
                                                                                VerticalAlignment="Center"
                                                                                Margin="0,0,8,0">
                                                                        <TextBlock Text="📌"
                                                                                   FontSize="14"
                                                                                   Margin="0,0,6,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"
                                                                                   ToolTip="{Binding [Pin], Source={StaticResource Loc}}"/>
                                                                        <TextBlock Text="🕒"
                                                                                   FontSize="13"
                                                                                   Margin="0,0,6,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Visibility="{Binding HasSchedule, Converter={StaticResource BoolToVis}}"
                                                                                   ToolTip="{Binding NextScheduleDisplay}"/>
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   FontSize="17"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource TextColor}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <Button x:Name="ListingContextMenuButton"
                                                                            Grid.Column="2"
                                                                            Tag="{Binding}"
                                                                            Content="&#x22EE;"
                                                                            Style="{StaticResource DashboardListingMenuButtonStyle}"
                                                                            ToolTip="{Binding [Menu], Source={StaticResource Loc}}"
                                                                            Click="ListingContextMenuButton_Click"/>
																</Grid>

                                                                <StackPanel Grid.Row="1"
                                                                            Orientation="Horizontal"
                                                                            Margin="0,14,0,0">
                                                                    <TextBlock Text="{Binding QuestionCountText}"
                                                                               FontSize="13"
                                                                               Foreground="{DynamicResource TextColorSecondary}"/>
                                                                </StackPanel>

                                                                <TextBlock Grid.Row="2"
                                                                           Text="{Binding TagsDisplay}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource TextColorSecondary}"
                                                                           TextWrapping="Wrap"
                                                                           MaxHeight="38"
                                                                           Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}"/>
                                                            </Grid>
                                                        </Border>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Row="2"
                                            HorizontalAlignment="Center"
                                            Margin="0,32,0,0"
                                            Visibility="{Binding HasQuizzes, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding [QuizzesEmptyDashboardPrompt], Source={StaticResource Loc}}"
                                               FontSize="18"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource TextColorSecondary}"
                                               HorizontalAlignment="Center"
                                               Margin="0,0,0,8"/>
                                    <Button Content="{Binding [CreateQuiz], Source={StaticResource Loc}}"
                                            Style="{StaticResource DialogPrimaryButtonStyle}"
                                            MinWidth="180"
                                            Padding="18,10"
                                            Click="CreateQuizButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <Button Style="{StaticResource FabStyle}"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Right"
                                Margin="0,0,28,24"
                                Content="+"
                                ToolTip="{Binding [CreateQuiz], Source={StaticResource Loc}}"
                                Click="CreateQuizButton_Click"/>
                    </Grid>
                </Grid>

                <!-- MIND MAPS VIEW -->
                <Grid Visibility="{Binding IsMindMapsView, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                      PreviewDragOver="DashboardScrollViewer_PreviewDragOver"
                                      PreviewDragLeave="DashboardScrollViewer_PreviewDragLeave"
                                      Drop="DashboardScrollViewer_Drop"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Padding="8">
                            <Grid Margin="0,0,0,18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border x:Name="MindMapCalendarSectionContainer"
                                        Visibility="{Binding IsCalendarSectionVisible, Converter={StaticResource BoolToVis}}"
                                        Background="{DynamicResource SidebarBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="0"
                                        CornerRadius="14"
                                        Padding="12"
                                        Margin="8,0,8,10"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="14" ShadowDepth="1" Direction="270"/>
                                    </Border.Effect>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Grid.Row" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCalendarFirst}" Value="False">
                                                    <Setter Property="Grid.Row" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid Margin="2,0,2,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Style="{StaticResource DashboardSectionMoveButtonStyle}"
                                                    Content="↑"
                                                    Margin="0,0,2,0"
                                                    ToolTip="{Binding [MoveCalendarSectionUp], Source={StaticResource Loc}}"
                                                    Click="MoveCalendarUpButton_Click"/>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource DashboardSectionMoveButtonStyle}"
                                                    Content="↓"
                                                    Margin="0,0,4,0"
                                                    ToolTip="{Binding [MoveCalendarSectionDown], Source={StaticResource Loc}}"
                                                    Click="MoveCalendarDownButton_Click"/>
                                            <Button Grid.Column="2"
                                                    ToolTip="{Binding [ToggleCalendarSection], Source={StaticResource Loc}}"
                                                    Click="ToggleCalendarSectionButton_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource DashboardSectionToggleButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCalendarSectionExpanded}" Value="False">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="-90"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <TextBlock Grid.Column="3"
                                                       Text="{Binding [CalendarSection], Source={StaticResource Loc}}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextColor}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid x:Name="MindMapCalendarSectionBody" Margin="2,0,2,2" Height="220">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
                                                    Background="{DynamicResource CardBackground}"
                                                    BorderBrush="{DynamicResource BorderColor}"
                                                    BorderThickness="0"
                                                    CornerRadius="12"
                                                    Padding="8">
                                                <Calendar x:Name="MindMapDashboardCalendar"
                                                          Style="{StaticResource DashboardCalendarControlStyle}"
                                                          SelectedDate="{Binding CalendarSelectedDate, Mode=TwoWay}"
                                                          SelectionMode="SingleDate"
                                                          SelectedDatesChanged="DashboardCalendar_SelectedDatesChanged"/>
                                            </Border>
                                            <Border Grid.Column="2"
                                                    Background="{DynamicResource CardBackground}"
                                                    BorderBrush="{DynamicResource BorderColor}"
                                                    BorderThickness="0"
                                                    CornerRadius="12"
                                                    Padding="8"
                                                    ClipToBounds="True"
                                                    Height="220">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding CalendarSelectedDateDisplay}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextColor}"
                                                               Margin="2,2,2,8"/>
                                                    <Grid Grid.Row="1">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="146">
                                                            <ItemsControl ItemsSource="{Binding CalendarScheduledNotes}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:CalendarScheduledItemViewModel}">
                                                                        <Border Style="{StaticResource CalendarScheduledItemCardStyle}"
                                                                                Tag="{Binding}"
                                                                                MouseLeftButtonUp="CalendarScheduledItemCard_MouseLeftButtonUp">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Button x:Name="CalendarScheduleGearButton"
                                                                                        Grid.Column="0"
                                                                                        Content="✎"
                                                                                        Style="{StaticResource TopBarIconButtonStyle}"
                                                                                        Width="30"
                                                                                        Height="30"
                                                                                        Margin="0,0,10,0"
                                                                                        VerticalAlignment="Center"
                                                                                        Tag="{Binding}"
                                                                                        ToolTip="{Binding [CalendarEditSchedule], Source={StaticResource Loc}}"
                                                                                        Click="CalendarScheduleGearButton_Click"/>
                                                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                                                    <TextBlock Text="{Binding Title}"
                                                                                               FontWeight="SemiBold"
                                                                                               Foreground="{DynamicResource TextColor}"
                                                                                               TextTrimming="CharacterEllipsis"
                                                                                               VerticalAlignment="Center"
                                                                                               Margin="0,0,0,6"/>
                                                                                    <TextBlock Text="{Binding ScheduleNote}"
                                                                                               TextWrapping="Wrap"
                                                                                               MaxHeight="34"
                                                                                               Foreground="{DynamicResource TextColorSecondary}">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                                <Style.Triggers>
                                                                                                    <Trigger Property="Text" Value="">
                                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                    </Trigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                                    <Border Background="{DynamicResource SelectionBackground}"
                                                                                            BorderBrush="{DynamicResource BorderColor}"
                                                                                            BorderThickness="1"
                                                                                            CornerRadius="8"
                                                                                            Padding="6,2"
                                                                                            Margin="0,0,4,0"
                                                                                            VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding TypeIcon}" FontSize="11" Foreground="{DynamicResource TextColor}"/>
                                                                                    </Border>
                                                                                    <Border Background="{DynamicResource SelectionBackground}"
                                                                                            BorderBrush="{DynamicResource BorderColor}"
                                                                                            BorderThickness="1"
                                                                                            CornerRadius="8"
                                                                                            Padding="8,2"
                                                                                            VerticalAlignment="Center">
                                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                            <TextBlock Text="🕒" Margin="0,0,4,0" FontSize="10" VerticalAlignment="Center"/>
                                                                                            <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                        <TextBlock Text="{Binding [CalendarNoSchedulesForDay], Source={StaticResource Loc}}"
                                                                   Foreground="{DynamicResource TextColorSecondary}"
                                                                   FontStyle="Italic"
                                                                   TextWrapping="Wrap"
                                                                   HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   TextAlignment="Center"
                                                                   Margin="10,10,10,10">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasCalendarScheduledNotes}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border
                                        Background="{DynamicResource SidebarBackground}"
                                        BorderBrush="{DynamicResource BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="14"
                                        Margin="8,0,8,10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Grid.Row" Value="1"/>
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasMindMaps}" Value="True"/>
                                                        <Condition Binding="{Binding IsMindMapGroupsSectionVisible}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding IsCalendarFirst}" Value="False">
                                                    <Setter Property="Grid.Row" Value="0"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="14" ShadowDepth="1" Direction="270"/>
                                    </Border.Effect>
                                    <StackPanel>
                                        <Grid Margin="2,0,2,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Style="{StaticResource DashboardSectionMoveButtonStyle}"
                                                    Content="↑"
                                                    Margin="0,0,2,0"
                                                    ToolTip="{Binding [MoveSectionUp], Source={StaticResource Loc}}"
                                                    Click="MoveDashboardContentUpButton_Click"/>
                                            <Button Grid.Column="1"
                                                    Style="{StaticResource DashboardSectionMoveButtonStyle}"
                                                    Content="↓"
                                                    Margin="0,0,4,0"
                                                    ToolTip="{Binding [MoveSectionDown], Source={StaticResource Loc}}"
                                                    Click="MoveDashboardContentDownButton_Click"/>
                                            <TextBlock Grid.Column="2"
                                                       Grid.ColumnSpan="2"
                                                       Text="{Binding [MindMapsDashboardTitle], Source={StaticResource Loc}}"
                                                       FontSize="16"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextColor}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center"/>
                                        </Grid>
                                        <!-- Mind Map Groups/Sets -->
                                        <Grid Margin="8,2,8,8"
                                              Visibility="{Binding HasMindMapGroups, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding [Groups], Source={StaticResource Loc}}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextColorSecondary}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding MindMapGroups}"
                                                      Visibility="{Binding HasMindMapGroups, Converter={StaticResource BoolToVis}}"
                                                      Margin="0,0,0,10">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:MindMapGroupViewModel}">
                                                    <Border Style="{StaticResource GroupCardStyle}"
                    Background="{Binding BackgroundBrush}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="10"
                    Margin="8,0,8,10"
                    AllowDrop="True"
                    PreviewDragOver="DashboardGroupBorder_PreviewDragOver"
                    PreviewDrop="DashboardGroupBorder_PreviewDrop">
                                                        <Border.Tag>
                                                            <Binding/>
                                                        </Border.Tag>
                                                        <StackPanel>
                                                            <!-- Group header with name and context menu -->
                                                            <Grid Margin="2,0,2,8">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Button Grid.Column="0"
                                                                        Style="{StaticResource GroupHeaderMoveButtonStyle}"
                                                                        Content="↑"
                                                                        Margin="0,0,3,0"
                                                                        Tag="{Binding}"
                                                                        ToolTip="{Binding [MoveThisGroupUp], Source={StaticResource Loc}}"
                                                                        Click="MoveDashboardGroupUpButton_Click"/>
                                                                <Button Grid.Column="1"
                                                                        Style="{StaticResource GroupHeaderMoveButtonStyle}"
                                                                        Content="↓"
                                                                        Margin="0,0,4,0"
                                                                        Tag="{Binding}"
                                                                        ToolTip="{Binding [MoveThisGroupDown], Source={StaticResource Loc}}"
                                                                        Click="MoveDashboardGroupDownButton_Click"/>
                                                                <Button Grid.Column="2"
                                                                        Style="{StaticResource GroupHeaderIconButtonStyle}"
                                                                        FontSize="13"
                                                                        Content="🎨"
                                                                        Margin="0,0,4,0"
                                                                        Tag="{Binding}"
                                                                        ToolTip="{Binding [GroupBackgroundColor], Source={StaticResource Loc}}"
                                                                        Click="DashboardGroupColorButton_Click">
                                                                    <Button.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="{Binding [GroupColorDefault], Source={StaticResource Loc}}" Tag="#F8FAFF" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorBlue], Source={StaticResource Loc}}" Tag="#EEF4FF" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorMint], Source={StaticResource Loc}}" Tag="#ECFDF3" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorRose], Source={StaticResource Loc}}" Tag="#FFF1F2" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorAmber], Source={StaticResource Loc}}" Tag="#FFFBEB" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorLilac], Source={StaticResource Loc}}" Tag="#F5F3FF" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorTeal], Source={StaticResource Loc}}" Tag="#F0FDFA" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorSlate], Source={StaticResource Loc}}" Tag="#F8FAFC" Click="DashboardGroupColorMenuItem_Click"/>
                                                                            <MenuItem Header="{Binding [GroupColorPeach], Source={StaticResource Loc}}" Tag="#FFF7ED" Click="DashboardGroupColorMenuItem_Click"/>
                                                                        </ContextMenu>
                                                                    </Button.ContextMenu>
                                                                </Button>
                                                                <Button Grid.Column="3"
                                Content="&#x22EE;"
                                Tag="{Binding}"
                                FontSize="16"
                                FontWeight="Bold"
                                Style="{StaticResource GroupHeaderIconButtonStyle}"
                                Click="DashboardGroupMenuButton_Click">
                                                                    <Button.ContextMenu>
                                                                        <ContextMenu>
                                                                            <MenuItem Header="{Binding [RenameGroup], Source={StaticResource Loc}}"
                                              Click="RenameDashboardGroupMenuItem_Click"/>
                                                                            <Separator/>
                                                                            <MenuItem Header="{Binding [DisbandGroup], Source={StaticResource Loc}}"
                                              Click="DisbandDashboardGroupMenuItem_Click"/>
                                                                        </ContextMenu>
                                                                    </Button.ContextMenu>
                                                                </Button>
                                                                <TextBlock Grid.Column="4"
                                   Text="{Binding Name}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="8,0,0,0"/>
                                                            </Grid>
                                                            <!-- Mind maps inside the group -->
                                                            <ItemsControl ItemsSource="{Binding MindMaps}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel Orientation="Horizontal"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:MindMapViewModel}">
                                                                        <Border Tag="{Binding}"
        Width="220" MinHeight="120"
        Margin="0,0,10,10"
        Background="Transparent"
        Cursor="Hand"
        AllowDrop="True"
        PreviewMouseLeftButtonDown="DashboardListing_PreviewMouseLeftButtonDown"
        MouseMove="DashboardListing_PreviewMouseMove"
        MouseLeftButtonUp="DashboardListing_MouseLeftButtonUp"
        DragEnter="DashboardListing_PreviewDragEnter"
        DragOver="DashboardListing_PreviewDragOver"
        DragLeave="DashboardListing_PreviewDragLeave"
        Drop="DashboardListing_PreviewDrop">
                                                                            <Border.ContextMenu>
                                                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                                    <MenuItem Header="{Binding [Open], Source={StaticResource Loc}}"
                  Click="OpenMindMapMenuItem_Click"/>
                                                                                    <MenuItem Header="{Binding [Duplicate], Source={StaticResource Loc}}"
                  Click="DuplicateMindMapMenuItem_Click"/>
                                                                                    <MenuItem Header="{Binding [RemoveFromGroup], Source={StaticResource Loc}}"
                                                                                              Visibility="{Binding Document.GroupId, Converter={StaticResource NullToVisibilityConverter}}"
                                                                                              Click="RemoveMindMapFromGroupMenuItem_Click"/>
                                                                                    <MenuItem Header="{Binding [CalendarAssignMenu], Source={StaticResource Loc}}" Click="ScheduleMindMapMenuItem_Click"/>
                                                                                    <Separator/>
                                                                                    <MenuItem Header="{Binding [Pin], Source={StaticResource Loc}}"
                                                                                              Click="ToggleMindMapPinMenuItem_Click"
                                                                                              Visibility="{Binding Document.IsPinned, Converter={StaticResource InverseBoolToVis}}"/>
                                                                                    <MenuItem Header="{Binding [Unpin], Source={StaticResource Loc}}"
                                                                                              Click="ToggleMindMapPinMenuItem_Click"
                                                                                              Visibility="{Binding Document.IsPinned, Converter={StaticResource BoolToVis}}"/>
                                                                                    <Separator/>
                                                                                    <MenuItem Header="{Binding [Delete], Source={StaticResource Loc}}"
                  Click="DeleteMindMapMenuItem_Click"/>
                                                                                </ContextMenu>
                                                                            </Border.ContextMenu>
                                                                            <Border Style="{StaticResource DashboardGroupedListingCardStyle}">
                                                                                <Grid>
                                                                                    <Grid.RowDefinitions>
                                                                                        <RowDefinition Height="Auto"/>
                                                                                        <RowDefinition Height="*"/>
                                                                                    </Grid.RowDefinitions>
                                                                                    <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                            <ColumnDefinition Width="*"/>
                                                                                            <ColumnDefinition Width="Auto"/>
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <Border Grid.Column="0"
                                                                                                Width="24"
                                                                                                Height="24"
                                                                                                Margin="0,0,6,0"
                                                                                                CornerRadius="12"
                                                                                                Background="{DynamicResource IconButtonBackground}"
                                                                                                BorderBrush="{DynamicResource IconButtonBorder}"
                                                                                                BorderThickness="1"
                                                                                                ToolTip="{Binding AiGeneratedTooltip}"
                                                                                                Visibility="{Binding IsAiGenerated, Converter={StaticResource BoolToVis}}">
                                                                                            <TextBlock Text="🤖"
                                                                                                       FontSize="13"
                                                                                                       Foreground="{DynamicResource TextColorSecondary}"
                                                                                                       HorizontalAlignment="Center"
                                                                                                       VerticalAlignment="Center"/>
                                                                                        </Border>
                                                                                        <StackPanel Grid.Column="1"
                                                                                                    Orientation="Horizontal"
                                                                                                    VerticalAlignment="Center"
                                                                                                    Margin="0,0,6,0">
                                                                                            <TextBlock Text="📌"
                                                                                                       FontSize="13"
                                                                                                       Margin="0,0,5,0"
                                                                                                       VerticalAlignment="Center"
                                                                                                       Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"
                                                                                                       ToolTip="{Binding [Pin], Source={StaticResource Loc}}"/>
                                                                                            <TextBlock Text="🕒"
                                                                                                       FontSize="12"
                                                                                                       Margin="0,0,5,0"
                                                                                                       VerticalAlignment="Center"
                                                                                                       Visibility="{Binding HasSchedule, Converter={StaticResource BoolToVis}}"
                                                                                                       ToolTip="{Binding NextScheduleDisplay}"/>
                                                                                            <TextBlock Text="{Binding Title}"
                                                                                                       FontSize="14"
                                                                                                       FontWeight="SemiBold"
                                                                                                       Foreground="{DynamicResource TextColor}"
                                                                                                       TextTrimming="CharacterEllipsis"
                                                                                                       VerticalAlignment="Center"/>
                                                                                        </StackPanel>
                                                                                        <Button x:Name="ListingContextMenuButton"
                                                                                                Grid.Column="2"
                                                                                                Tag="{Binding}"
                                                                                                Content="&#x22EE;"
                                                                                                Style="{StaticResource DashboardListingMenuButtonStyle}"
                                                                                                ToolTip="{Binding [Menu], Source={StaticResource Loc}}"
                                                                                                Click="ListingContextMenuButton_Click"/>
                                                                                    </Grid>
                                                                                    <TextBlock Grid.Row="1"
                       Text="{Binding NodeCountText}"
                       FontSize="12"
                       Foreground="{DynamicResource TextColorSecondary}"
                       Margin="0,6,0,0"/>
                                                                                </Grid>
                                                                            </Border>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Border Margin="0,0,0,10"
                                                MinHeight="96"
                                                Background="Transparent"
                                                AllowDrop="True"
                                                DragOver="DashboardUngroupedDropZone_DragOver"
                                                Drop="DashboardUngroupedDropZone_Drop"
                                                Visibility="{Binding HasMindMaps, Converter={StaticResource BoolToVis}}">
                                            <StackPanel>
                                        <Grid Margin="8,2,8,8"
                                              Background="Transparent"
                                              AllowDrop="True"
                                              DragOver="DashboardUngroupedDropZone_DragOver"
                                              Drop="DashboardUngroupedDropZone_Drop"
                                              Visibility="{Binding HasMindMaps, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="{Binding [UngroupedItems], Source={StaticResource Loc}}"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextColorSecondary}"/>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding MindMapsView}"
                                                      AllowDrop="True"
                                                      DragOver="DashboardUngroupedDropZone_DragOver"
                                                      Drop="DashboardUngroupedDropZone_Drop"
                                                      Visibility="{Binding HasUngroupedMindMaps, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:MindMapViewModel}">
													<Border x:Name="MindMapCardButton"
															Tag="{Binding}"
															Width="330"
															MinHeight="184"
                                                            Margin="0,0,14,14"
                                                            Background="Transparent"
																																								Cursor="Hand"
                                                            AllowDrop="True"
                                                            PreviewMouseLeftButtonDown="DashboardListing_PreviewMouseLeftButtonDown"
                                                            MouseMove="DashboardListing_PreviewMouseMove"
                                                            MouseLeftButtonUp="DashboardListing_MouseLeftButtonUp"
                                                            DragEnter="DashboardListing_PreviewDragEnter"
                                                            DragOver="DashboardListing_PreviewDragOver"
                                                            DragLeave="DashboardListing_PreviewDragLeave"
                                                            Drop="DashboardListing_PreviewDrop">
                                                        <Border.ContextMenu>
                                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                <MenuItem Header="{Binding [Open], Source={StaticResource Loc}}"
                  Click="OpenMindMapMenuItem_Click"/>
                                                                <MenuItem Header="{Binding [Duplicate], Source={StaticResource Loc}}"
                  Click="DuplicateMindMapMenuItem_Click"/>
                                                                <MenuItem Header="{Binding [RemoveFromGroup], Source={StaticResource Loc}}"
                                                                          Visibility="{Binding Document.GroupId, Converter={StaticResource NullToVisibilityConverter}}"
                                                                          Click="RemoveMindMapFromGroupMenuItem_Click"/>
                                                                <MenuItem Header="{Binding [CalendarAssignMenu], Source={StaticResource Loc}}" Click="ScheduleMindMapMenuItem_Click"/>
                                                                <Separator/>
                                                                <MenuItem Header="{Binding [Pin], Source={StaticResource Loc}}"
                                                                          Click="ToggleMindMapPinMenuItem_Click"
                                                                          Visibility="{Binding Document.IsPinned, Converter={StaticResource InverseBoolToVis}}"/>
                                                                <MenuItem Header="{Binding [Unpin], Source={StaticResource Loc}}"
                                                                          Click="ToggleMindMapPinMenuItem_Click"
                                                                          Visibility="{Binding Document.IsPinned, Converter={StaticResource BoolToVis}}"/>
                                                                <Separator/>
                                                                <MenuItem Header="{Binding [Delete], Source={StaticResource Loc}}"
                  Click="DeleteMindMapMenuItem_Click"/>
                                                            </ContextMenu>
                                                        </Border.ContextMenu>
                                                        <Border x:Name="MindMapCardBorder"
                                                                Background="{DynamicResource CardBackground}"
                                                                BorderBrush="{DynamicResource BorderColor}"
                                                                BorderThickness="1"
                                                                CornerRadius="14"
                                                                Padding="16"
                                                                Opacity="0"
                                                                RenderTransformOrigin="0.5,0.5">
                                                            <Border.RenderTransform>
                                                                <TransformGroup>
                                                                    <ScaleTransform ScaleX="0.88" ScaleY="0.88"/>
                                                                    <TranslateTransform Y="0"/>
                                                                </TransformGroup>
                                                            </Border.RenderTransform>
                                                            <Border.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                             From="0"
                                                                                             To="1"
                                                                                             Duration="0:0:0.25">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                                             From="0"
                                                                                             To="0"
                                                                                             Duration="0:0:0.25">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                                             From="0.88"
                                                                                             To="1"
                                                                                             Duration="0:0:0.32">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <BackEase EasingMode="EaseOut" Amplitude="0.25"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                                             From="0.88"
                                                                                             To="1"
                                                                                             Duration="0:0:0.32">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <BackEase EasingMode="EaseOut" Amplitude="0.25"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                                <EventTrigger RoutedEvent="MouseEnter">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="MindMapCardBorder"
                                                                                             Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                                                             To="14"
                                                                                             Duration="0:0:0.18"/>
                                                                            <DoubleAnimation Storyboard.TargetName="MindMapCardBorder"
                                                                                             Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                                                             To="0.18"
                                                                                             Duration="0:0:0.18"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                                             To="1.02"
                                                                                             Duration="0:0:0.18"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                                             To="1.02"
                                                                                             Duration="0:0:0.18"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                                <EventTrigger RoutedEvent="MouseLeave">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="MindMapCardBorder"
                                                                                             Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                                                             To="8"
                                                                                             Duration="0:0:0.2"/>
                                                                            <DoubleAnimation Storyboard.TargetName="MindMapCardBorder"
                                                                                             Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                                                             To="0.08"
                                                                                             Duration="0:0:0.2"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                                             To="1.0"
                                                                                             Duration="0:0:0.2"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                                             To="1.0"
                                                                                             Duration="0:0:0.2"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </Border.Triggers>
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="8" ShadowDepth="1" Direction="270"/>
                                                            </Border.Effect>
															<Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>

																<Popup Placement="MousePoint"
																	   PlacementTarget="{Binding ElementName=MindMapContentPreviewBorder}"
																	   AllowsTransparency="True"
																	   PopupAnimation="Fade"
																	   StaysOpen="True">
																	<Popup.Style>
																		<Style TargetType="Popup">
																			<Setter Property="IsOpen" Value="False"/>
																			<Style.Triggers>
																				<MultiDataTrigger>
																					<MultiDataTrigger.Conditions>
																						<Condition Binding="{Binding PlacementTarget.DataContext.HasHoverContentPreview, RelativeSource={RelativeSource Self}}" Value="True"/>
																						<Condition Binding="{Binding PlacementTarget.IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
																					</MultiDataTrigger.Conditions>
																					<Setter Property="IsOpen" Value="True"/>
																				</MultiDataTrigger>
																			</Style.Triggers>
																		</Style>
																	</Popup.Style>
																	<Border DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=Popup}}"
																			IsHitTestVisible="False"
																			Background="{DynamicResource CardBackground}"
																			BorderBrush="{DynamicResource BorderColor}"
																			BorderThickness="1"
																			CornerRadius="10"
																			Padding="12"
																			MinWidth="360"
																			MaxWidth="480"
																			MaxHeight="360">
																		<StackPanel>
																			<TextBlock Text="{Binding Title}"
																					   FontSize="14"
																					   FontWeight="SemiBold"
																					   Foreground="{DynamicResource TextColor}"
																					   Margin="0,0,0,8"
																					   TextTrimming="CharacterEllipsis"/>
																			<ScrollViewer VerticalScrollBarVisibility="Auto"
																						  HorizontalScrollBarVisibility="Disabled">
																				<ItemsControl ItemsSource="{Binding HoverContentPreviewItems}">
																					<ItemsControl.ItemTemplate>
																						<DataTemplate>
																							<TextBlock Text="{Binding}"
																									   Foreground="{DynamicResource TextColorSecondary}"
																									   FontSize="13"
																									   TextWrapping="Wrap"
																									   Margin="0,1,0,1"/>
																						</DataTemplate>
																					</ItemsControl.ItemTemplate>
																				</ItemsControl>
																			</ScrollViewer>
																		</StackPanel>
																	</Border>
																</Popup>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Border Grid.Column="0"
                                                                            Width="24"
                                                                            Height="24"
                                                                            Margin="0,0,6,0"
                                                                            CornerRadius="12"
                                                                            Background="{DynamicResource IconButtonBackground}"
                                                                            BorderBrush="{DynamicResource IconButtonBorder}"
                                                                            BorderThickness="1"
                                                                            ToolTip="{Binding AiGeneratedTooltip}"
                                                                            Visibility="{Binding IsAiGenerated, Converter={StaticResource BoolToVis}}">
                                                                       <TextBlock Text="🤖"
                                                                                  FontSize="13"
                                                                                  Foreground="{DynamicResource TextColorSecondary}"
                                                                                  HorizontalAlignment="Center"
                                                                                  VerticalAlignment="Center"/>
                                                                    </Border>
                                                                    <StackPanel Grid.Column="1"
                                                                                Orientation="Horizontal"
                                                                                VerticalAlignment="Center"
                                                                                Margin="0,0,8,0">
                                                                        <TextBlock Text="📌"
                                                                                   FontSize="14"
                                                                                   Margin="0,0,6,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}"
                                                                                   ToolTip="{Binding [Pin], Source={StaticResource Loc}}"/>
                                                                        <TextBlock Text="🕒"
                                                                                   FontSize="13"
                                                                                   Margin="0,0,6,0"
                                                                                   VerticalAlignment="Center"
                                                                                   Visibility="{Binding HasSchedule, Converter={StaticResource BoolToVis}}"
                                                                                   ToolTip="{Binding NextScheduleDisplay}"/>
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   FontSize="17"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource TextColor}"
                                                                                   TextTrimming="CharacterEllipsis"
                                                                                   VerticalAlignment="Center"/>
                                                                    </StackPanel>
                                                                    <Button x:Name="ListingContextMenuButton"
                                                                            Grid.Column="2"
                                                                            Tag="{Binding}"
                                                                            Content="&#x22EE;"
                                                                            Style="{StaticResource DashboardListingMenuButtonStyle}"
                                                                            ToolTip="{Binding [Menu], Source={StaticResource Loc}}"
                                                                            Click="ListingContextMenuButton_Click"/>
                                                                </Grid>

																<Grid Grid.Row="1"
																	  Margin="0,12,0,0"
																	  Visibility="{Binding HasContentPreview, Converter={StaticResource BoolToVis}}">
																	<Grid.ColumnDefinitions>
													<ColumnDefinition Width="180"/>
																		<ColumnDefinition Width="*"/>
																	</Grid.ColumnDefinitions>

																	<TextBlock Grid.Column="0"
																			   Text="{Binding NodeCountText}"
																			   FontSize="13"
																			   Foreground="{DynamicResource TextColorSecondary}"
																			   VerticalAlignment="Top"/>

																	<Border x:Name="MindMapContentPreviewBorder"
																			Grid.Column="1"
																			Background="{DynamicResource WindowBackground}"
																			BorderBrush="{DynamicResource BorderColor}"
																			BorderThickness="1"
																			CornerRadius="8"
													Padding="10,8"
																			Margin="8,0,0,0"
													MinHeight="82">
																		<ScrollViewer VerticalScrollBarVisibility="Auto"
																					  HorizontalScrollBarVisibility="Disabled">
																			<ItemsControl ItemsSource="{Binding ContentPreviewItems}">
																				<ItemsControl.ItemTemplate>
																					<DataTemplate>
																						<TextBlock Text="{Binding}"
																								   Foreground="{DynamicResource TextColorSecondary}"
																		   FontSize="13"
																								   TextTrimming="CharacterEllipsis"
																		   Margin="0,2,0,2"/>
																					</DataTemplate>
																				</ItemsControl.ItemTemplate>
																			</ItemsControl>
																		</ScrollViewer>
																	</Border>
																</Grid>

																<StackPanel Grid.Row="1"
																			Orientation="Horizontal"
																			Margin="0,14,0,0"
																			Visibility="{Binding HasContentPreview, Converter={StaticResource InverseBoolToVisibilityConverter}}">
																	<TextBlock Text="{Binding NodeCountText}"
																			   FontSize="13"
																			   Foreground="{DynamicResource TextColorSecondary}"/>
																	<TextBlock Text="  •  "
																			   FontSize="13"
																			   Foreground="{DynamicResource TextColorSecondary}"/>
																	<TextBlock Text="{Binding BranchCountText}"
																			   FontSize="13"
																			   Foreground="{DynamicResource TextColorSecondary}"/>
																</StackPanel>

                                                                <TextBlock Grid.Row="2"
                                                                           Text="{Binding TagsDisplay}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource TextColorSecondary}"
                                                                           TextWrapping="Wrap"
                                                                           MaxHeight="38"
                                                                           Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}"/>
                                                            </Grid>
                                                        </Border>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Row="2"
                                            HorizontalAlignment="Center"
                                            Margin="0,32,0,0"
                                            Visibility="{Binding HasMindMaps, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding [MindMapsEmptyDashboardPrompt], Source={StaticResource Loc}}"
                                               FontSize="18"
                                               FontStyle="Italic"
                                               Foreground="{DynamicResource TextColorSecondary}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"
                                               MaxWidth="520"
                                               Margin="0,0,0,8"/>
                                    <Button Content="{Binding [CreateMindMap], Source={StaticResource Loc}}"
                                            Style="{StaticResource DialogPrimaryButtonStyle}"
                                            MinWidth="180"
                                            Padding="18,10"
                                            Click="CreateMindMapButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                    <Button Style="{StaticResource FabStyle}"
                            VerticalAlignment="Bottom"
                            HorizontalAlignment="Right"
                            Margin="0,0,28,24"
                            Content="+"
                            ToolTip="{Binding [CreateMindMap], Source={StaticResource Loc}}"
                            Click="CreateMindMapButton_Click"/>
                </Grid>
                
            </Grid>
        </Grid>

		<Views:SettingsPanel x:Name="SettingsPanelControl"
						 x:FieldModifier="public"
						 Grid.ColumnSpan="2"
						 Visibility="Collapsed"
						 HorizontalAlignment="Stretch"
						 VerticalAlignment="Stretch"
						 Panel.ZIndex="200"/>

		<Views:AboutPanel x:Name="AboutPanelControl"
					  x:FieldModifier="public"
					  Grid.ColumnSpan="2"
					  Visibility="Collapsed"
					  HorizontalAlignment="Stretch"
					  VerticalAlignment="Stretch"
					  Panel.ZIndex="201"/>

		<Views:NoteSchedulePanel x:Name="NoteSchedulePanelControl"
							 x:FieldModifier="public"
							 Grid.ColumnSpan="2"
							 Visibility="Collapsed"
							 HorizontalAlignment="Stretch"
							 VerticalAlignment="Stretch"
							 Panel.ZIndex="202"/>
        <Grid Visibility="{Binding SelectedFlashcard, Converter={StaticResource NullToVisibilityConverter}}"
      Background="#80000000"
      Panel.ZIndex="9999"
      Grid.ColumnSpan="2"
      Grid.RowSpan="2">

            <Grid HorizontalAlignment="Center"
          VerticalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- PREVIOUS -->
                <Button Grid.Column="0"
                Content="◀"
                Width="40"
                Height="60"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Command="{Binding PreviousFlashcardCommand}"/>

                <!-- CARD -->
                <Border Grid.Column="1"
                Width="400"
                Padding="20"
				Background="{DynamicResource CardBackground}"
				BorderBrush="{DynamicResource BorderColor}"
				BorderThickness="1"
                CornerRadius="10">

                    <StackPanel>

                        <TextBlock Text="{Binding SelectedFlashcard.Question}"
                           FontSize="18"
                           FontWeight="Bold"
							  Foreground="{DynamicResource TextColor}"
                           TextAlignment="Center"
                           Visibility="{Binding IsShowingAnswer, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <TextBlock Text="{Binding SelectedFlashcard.Answer}"
                           FontSize="18"
							  Foreground="{DynamicResource TextColor}"
                           TextAlignment="Center"
                           Visibility="{Binding IsShowingAnswer, Converter={StaticResource BoolToVis}}"/>

                        <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0">

                            <Button Content="Flip"
                            Command="{Binding FlipFlashcardCommand}"
                            Margin="5"/>

                            <Button Content="Close"
                            Command="{Binding CloseFlashcardCommand}"
                            Margin="5"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

                <!-- NEXT -->
                <Button Grid.Column="2"
                Content="▶"
                Width="40"
                Height="60"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding NextFlashcardCommand}"/>

            </Grid>

        </Grid>
    </Grid>
</Window>
