<Window x:Class="NoteCards.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NoteCards.Controls"
        xmlns:vm="clr-namespace:NoteCards.ViewModels"
        xmlns:Views="clr-namespace:NoteCards.Views"
        xmlns:converters="clr-namespace:NoteCards.Converters"
        Title="NoteCards" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
		UseLayoutRounding="True"
		SnapsToDevicePixels="True"
		TextOptions.TextFormattingMode="Display"
		TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <Style x:Key="RecentNoteCardStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Background" Value="{DynamicResource CardBackground}"/>
			<Setter Property="Padding" Value="12,10"/>
			<Setter Property="Margin" Value="0,0,8,0"/>
			<Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="CardBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{DynamicResource BorderColor}"
								BorderThickness="1"
								CornerRadius="8"
								Padding="{TemplateBinding Padding}">
							<Border.Effect>
								<DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
							</Border.Effect>
                         <ContentPresenter Content="{TemplateBinding Content}"
											  ContentTemplate="{TemplateBinding ContentTemplate}"
											  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
											  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<DataTrigger Binding="{Binding DataContext.IsMassSelectMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
					<Setter Property="Opacity" Value="0.55"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="CalendarScheduledItemCardStyle" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource CardBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="11"/>
			<Setter Property="Margin" Value="0,0,0,8"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="10" ShadowDepth="1" Direction="270"/>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
					<Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="CalendarScheduledItemButtonStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
         <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
           <Setter Property="Padding" Value="12,10"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="ScheduledItemBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
								Padding="{TemplateBinding Padding}"
								Margin="1">
                            <Border.Effect>
								<DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="8" ShadowDepth="1" Direction="270"/>
							</Border.Effect>
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
											  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="ScheduledItemBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
								<Setter TargetName="ScheduledItemBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="ScheduledItemBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                              <Setter TargetName="ScheduledItemBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="MassActionIconButtonStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Width" Value="34"/>
			<Setter Property="Height" Value="34"/>
			<Setter Property="Margin" Value="0,0,6,0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
			<Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource IconButtonBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="MassActionBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="9">
							<Border.Effect>
								<DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08"/>
							</Border.Effect>
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="MassActionBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
								<Setter TargetName="MassActionBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="MassActionBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
								<Setter TargetName="MassActionBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.45"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="TopBarIconButtonStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
			<Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource IconButtonBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Width" Value="34"/>
			<Setter Property="Height" Value="32"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="TopBarIconBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="8">
							<Border.Effect>
								<DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08"/>
							</Border.Effect>
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="TopBarIconBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
								<Setter TargetName="TopBarIconBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="TopBarIconBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
								<Setter TargetName="TopBarIconBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsMassSelectMode}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
					<Setter Property="Opacity" Value="0.55"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="FloatingSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TopBarIconButtonStyle}">
			<Setter Property="Width" Value="36"/>
			<Setter Property="Height" Value="34"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="FloatingSecondaryBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="10">
							<Border.Effect>
								<DropShadowEffect Color="#000000" Opacity="0.20" BlurRadius="16" ShadowDepth="3" Direction="270"/>
							</Border.Effect>
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FloatingSecondaryBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
								<Setter TargetName="FloatingSecondaryBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FloatingSecondaryBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
								<Setter TargetName="FloatingSecondaryBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
            <Style.Triggers>
				<DataTrigger Binding="{Binding IsMassSelectMode}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
					<Setter Property="Opacity" Value="0.55"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarActionButtonStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Margin" Value="0,0,0,6"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="SidebarButtonBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="10"
								Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
											  VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SidebarButtonBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
								<Setter TargetName="SidebarButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SidebarButtonBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
								<Setter TargetName="SidebarButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
								<Setter Property="HorizontalContentAlignment" Value="Center"/>
								<Setter Property="Padding" Value="0"/>
								<Setter Property="Height" Value="38"/>
							</DataTrigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
            <Style.Triggers>
				<DataTrigger Binding="{Binding DataContext.IsMassSelectMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
					<Setter Property="Opacity" Value="0.55"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarLabelTextStyle" TargetType="TextBlock">
			<Setter Property="Margin" Value="10,0,0,0"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
					<Setter Property="Visibility" Value="Collapsed"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarNotesDashboardButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarActionButtonStyle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsNotesView}" Value="True">
					<Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
					<Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
					<Setter Property="FontWeight" Value="SemiBold"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarFlashcardsDashboardButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarActionButtonStyle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsFlashcardsView}" Value="True">
					<Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
					<Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
					<Setter Property="FontWeight" Value="SemiBold"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarQuizzesDashboardButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarActionButtonStyle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsQuizzesView}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
					<Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
					<Setter Property="FontWeight" Value="SemiBold"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarMindMapsDashboardButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarActionButtonStyle}">
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsMindMapsView}" Value="True">
					<Setter Property="Background" Value="{DynamicResource SelectionBackground}"/>
					<Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
					<Setter Property="FontWeight" Value="SemiBold"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>
		
		
        <converters:BoolToScrollBarVisibilityConverter x:Key="BoolToScrollBarVisibilityConverter" />
        <ItemsPanelTemplate x:Key="UngroupedGridItemsPanel">
			<WrapPanel Orientation="Horizontal"/>
		</ItemsPanelTemplate>
		<ItemsPanelTemplate x:Key="UngroupedListItemsPanel">
			<StackPanel Orientation="Vertical"/>
		</ItemsPanelTemplate>
		<Style x:Key="PopupMenuButtonStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Padding" Value="12,9"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type Button}">
						<Border x:Name="PopupItemBorder"
								Background="{TemplateBinding Background}"
								CornerRadius="6"
								Padding="{TemplateBinding Padding}"
								Margin="2">
							<TextBlock Text="{TemplateBinding Content}"
									   Foreground="{TemplateBinding Foreground}"
									   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="PopupItemBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="PopupItemBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
								<Setter Property="Opacity" Value="0.6"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="FabStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
			<Setter Property="FontSize" Value="26"/>
			<Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
			<Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource IconButtonBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Width" Value="52"/>
			<Setter Property="Height" Value="52"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type Button}">
						<Border x:Name="FabBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="14">
							<Border.Effect>
								<DropShadowEffect Color="#000000" Opacity="0.20"
												  BlurRadius="16" ShadowDepth="3"
												  Direction="270"/>
							</Border.Effect>
							<TextBlock Text="{TemplateBinding Content}"
									   Foreground="{TemplateBinding Foreground}"
									   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
									   Margin="0,-3,0,0"
									   FontSize="{TemplateBinding FontSize}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="FabBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
								<Setter TargetName="FabBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="FabBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
								<Setter TargetName="FabBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
						   <Trigger Property="IsEnabled" Value="False">
								<Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
								<Setter TargetName="FabBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
								<Setter TargetName="FabBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
								<Setter TargetName="FabBorder" Property="Opacity" Value="0.62"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="GroupCardStyle" TargetType="Border">
			<Setter Property="Opacity" Value="0"/>
			<Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
			<Setter Property="RenderTransform">
				<Setter.Value>
					<TranslateTransform Y="10"/>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<EventTrigger RoutedEvent="Loaded">
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation Storyboard.TargetProperty="Opacity"
											 To="1"
											 Duration="0:0:0.25"/>
							<DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
											 To="0"
											 Duration="0:0:0.25">
								<DoubleAnimation.EasingFunction>
									<CubicEase EasingMode="EaseOut"/>
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</EventTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="DashboardGroupedListingCardStyle" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource CardBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="12"/>
			<Setter Property="Opacity" Value="0"/>
			<Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="8" ShadowDepth="1" Direction="270"/>
				</Setter.Value>
			</Setter>
			<EventSetter Event="Loaded" Handler="DashboardGroupedListingCard_Loaded"/>
			<EventSetter Event="MouseEnter" Handler="DashboardGroupedListingCard_MouseEnter"/>
			<EventSetter Event="MouseLeave" Handler="DashboardGroupedListingCard_MouseLeave"/>
		</Style>

		<Style x:Key="DashboardSectionToggleButtonStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Width" Value="30"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource IconButtonBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Content" Value="▾"/>
			<Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
			<Setter Property="RenderTransform">
				<Setter.Value>
					<RotateTransform Angle="0"/>
				</Setter.Value>
			</Setter>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="ToggleBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="9">
							<Border.Effect>
								<DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08"/>
							</Border.Effect>
							<TextBlock Text="{TemplateBinding Content}"
									   Foreground="{TemplateBinding Foreground}"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center"
									   Margin="0,-1,0,0"
									   FontSize="{TemplateBinding FontSize}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
								<Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
								<Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
						 <Trigger Property="IsEnabled" Value="False">
								<Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
								<Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
								<Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
								<Setter TargetName="ToggleBorder" Property="Opacity" Value="0.65"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DashboardSectionMoveButtonStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Width" Value="28"/>
			<Setter Property="Height" Value="28"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource IconButtonBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="MoveBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="8">
							<Border.Effect>
								<DropShadowEffect BlurRadius="7" ShadowDepth="1" Opacity="0.07"/>
							</Border.Effect>
							<TextBlock Text="{TemplateBinding Content}"
									   Foreground="{TemplateBinding Foreground}"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center"
									   Margin="0,-1,0,0"
									   FontWeight="{TemplateBinding FontWeight}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="MoveBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
								<Setter TargetName="MoveBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="MoveBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
								<Setter TargetName="MoveBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="GroupHeaderMoveButtonStyle" TargetType="Button" BasedOn="{StaticResource DashboardSectionMoveButtonStyle}">
			<Setter Property="Width" Value="24"/>
			<Setter Property="Height" Value="24"/>
			<Setter Property="FontSize" Value="11"/>
		</Style>

		<Style x:Key="GroupHeaderIconButtonStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Width" Value="28"/>
			<Setter Property="Height" Value="28"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource IconButtonBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="GroupIconBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="8">
							<Border.Effect>
								<DropShadowEffect BlurRadius="7" ShadowDepth="1" Opacity="0.07"/>
							</Border.Effect>
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="GroupIconBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
								<Setter TargetName="GroupIconBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="GroupIconBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
								<Setter TargetName="GroupIconBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DashboardListingMenuButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="Width" Value="28"/>
			<Setter Property="Height" Value="28"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="FontSize" Value="16"/>
			<Setter Property="FontWeight" Value="Bold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Visibility" Value="Collapsed"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="MenuButtonBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="8">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="MenuButtonBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
								<Setter TargetName="MenuButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="MenuButtonBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
								<Setter TargetName="MenuButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}" Value="True">
					<Setter Property="Visibility" Value="Visible"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="DashboardCalendarDayButtonStyle" TargetType="CalendarDayButton">
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
           <Setter Property="Margin" Value="1"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="CalendarDayButton">
						<Border x:Name="DayBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
								Padding="3">
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
											  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
								<Setter TargetName="DayBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="DayBorder" Property="Background" Value="#3F6FE8"/>
								<Setter TargetName="DayBorder" Property="BorderBrush" Value="#2F5CD0"/>
								<Setter Property="Foreground" Value="White"/>
							</Trigger>
							<Trigger Property="IsInactive" Value="True">
								<Setter Property="Opacity" Value="0.45"/>
							</Trigger>
							<Trigger Property="IsToday" Value="True">
                             <Setter TargetName="DayBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
								<Setter TargetName="DayBorder" Property="BorderThickness" Value="2"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DashboardCalendarHeaderButtonStyle" TargetType="Button">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="HeaderButtonBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="8">
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"
											  RecognizesAccessKey="True"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="HeaderButtonBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
								<Setter TargetName="HeaderButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="HeaderButtonBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
								<Setter TargetName="HeaderButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.45"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DashboardCalendarButtonStyle" TargetType="CalendarButton">
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Margin" Value="2"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="CalendarButton">
						<Border x:Name="CalendarButtonBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="9"
								Padding="4">
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
											  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="CalendarButtonBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
								<Setter TargetName="CalendarButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsInactive" Value="True">
								<Setter Property="Opacity" Value="0.45"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DashboardCalendarItemStyle" TargetType="CalendarItem">
			<Setter Property="Background" Value="{DynamicResource CardBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="CalendarItem">
						<Border Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="0"
								CornerRadius="10"
								Padding="2"
								SnapsToDevicePixels="True">
							<Grid x:Name="PART_Root">
								<Grid.Resources>
									<Style TargetType="TextBlock">
										<Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
										<Setter Property="HorizontalAlignment" Value="Center"/>
										<Setter Property="VerticalAlignment" Value="Center"/>
									</Style>
								</Grid.Resources>
								<Grid.RowDefinitions>
									<RowDefinition Height="32"/>
									<RowDefinition Height="*"/>
								</Grid.RowDefinitions>
								<Grid Margin="0,0,0,4">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="30"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="30"/>
									</Grid.ColumnDefinitions>
									<Button x:Name="PART_PreviousButton"
											Style="{StaticResource DashboardCalendarHeaderButtonStyle}"
											Width="28"
											Height="28">
										<Path Data="M 7 0 L 0 7 L 7 14"
											  Stroke="{DynamicResource TextColor}"
											  StrokeThickness="2"
											  StrokeStartLineCap="Round"
											  StrokeEndLineCap="Round"
											  StrokeLineJoin="Round"
											  Width="7"
											  Height="14"
											  Stretch="Uniform"
											  HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
									</Button>
									<Button x:Name="PART_HeaderButton"
											Grid.Column="1"
											Style="{StaticResource DashboardCalendarHeaderButtonStyle}"
											FontSize="13"
											FontWeight="SemiBold"
											HorizontalContentAlignment="Center"
											VerticalContentAlignment="Center"/>
									<Button x:Name="PART_NextButton"
											Grid.Column="2"
											Style="{StaticResource DashboardCalendarHeaderButtonStyle}"
											Width="28"
											Height="28">
										<Path Data="M 0 0 L 7 7 L 0 14"
											  Stroke="{DynamicResource TextColor}"
											  StrokeThickness="2"
											  StrokeStartLineCap="Round"
											  StrokeEndLineCap="Round"
											  StrokeLineJoin="Round"
											  Width="7"
											  Height="14"
											  Stretch="Uniform"
											  HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
									</Button>
								</Grid>
								<Grid x:Name="PART_MonthView"
									  Grid.Row="1"
									  TextElement.Foreground="{DynamicResource TextColorSecondary}">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="*"/>
										<RowDefinition Height="*"/>
										<RowDefinition Height="*"/>
										<RowDefinition Height="*"/>
										<RowDefinition Height="*"/>
										<RowDefinition Height="*"/>
										<RowDefinition Height="*"/>
									</Grid.RowDefinitions>
								</Grid>
								<Grid x:Name="PART_YearView"
									  Grid.Row="1"
									  Visibility="Hidden">
									<Grid.ColumnDefinitions>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
										<ColumnDefinition Width="*"/>
									</Grid.ColumnDefinitions>
									<Grid.RowDefinitions>
										<RowDefinition Height="*"/>
										<RowDefinition Height="*"/>
										<RowDefinition Height="*"/>
									</Grid.RowDefinitions>
								</Grid>
							</Grid>
						</Border>
						<ControlTemplate.Triggers>
							<DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Year">
								<Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
								<Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
							</DataTrigger>
							<DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Decade">
								<Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden"/>
								<Setter TargetName="PART_YearView" Property="Visibility" Value="Visible"/>
							</DataTrigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.6"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DashboardCalendarControlStyle" TargetType="Calendar">
			<Setter Property="Background" Value="{DynamicResource CardBackground}"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
               <Setter Property="Padding" Value="4"/>
			<Setter Property="CalendarDayButtonStyle" Value="{StaticResource DashboardCalendarDayButtonStyle}"/>
			<Setter Property="CalendarButtonStyle" Value="{StaticResource DashboardCalendarButtonStyle}"/>
			<Setter Property="CalendarItemStyle" Value="{StaticResource DashboardCalendarItemStyle}"/>
            <Setter Property="FontSize" Value="13"/>
		</Style>
	</Window.Resources>
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
	<Grid>

		<Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="SidebarColumn" Width="64"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- Sidebar -->
     <Border Grid.Column="0"
				Background="{DynamicResource SidebarBackground}"
				BorderBrush="{DynamicResource BorderColor}"
				BorderThickness="0,0,1,0"
             IsEnabled="{Binding IsNotMassSelectMode}"
				Padding="8,10">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<Button Command="{Binding ToggleSidebarCommand}"
						Style="{StaticResource SidebarActionButtonStyle}"
						Margin="0,0,0,10"
						ToolTip="{Binding [Menu], Source={StaticResource Loc}}">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<TextBlock Text="☰" FontSize="16" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
						<TextBlock Style="{StaticResource SidebarLabelTextStyle}"
								   Text="{Binding [Menu], Source={StaticResource Loc}}"
								   FontWeight="SemiBold"/>
					</StackPanel>
				</Button>

				<ScrollViewer Grid.Row="1"
							  VerticalScrollBarVisibility="Auto"
							  HorizontalScrollBarVisibility="Disabled">
					<StackPanel>
						<Separator Margin="6,10,6,10"/>
						<Button Style="{StaticResource SidebarNotesDashboardButtonStyle}"
								Command="{Binding ShowNotesCommand}"
								Margin="0,5"
								ToolTip="{Binding [NotesDashboard], Source={StaticResource Loc}}">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<TextBlock Text="📝" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
								<TextBlock Style="{StaticResource SidebarLabelTextStyle}" Text="{Binding [NotesDashboard], Source={StaticResource Loc}}"/>
							</StackPanel>
						</Button>

                        <Button Style="{StaticResource SidebarFlashcardsDashboardButtonStyle}"
								Command="{Binding ShowFlashcardsCommand}"
								Margin="0,5"
								ToolTip="{Binding [FlashcardsDashboard], Source={StaticResource Loc}}">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<TextBlock Text="🧠" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
								<TextBlock Style="{StaticResource SidebarLabelTextStyle}" Text="{Binding [FlashcardsDashboard], Source={StaticResource Loc}}"/>
							</StackPanel>
						</Button>

                        <Button Style="{StaticResource SidebarMindMapsDashboardButtonStyle}"
								Command="{Binding ShowMindMapsCommand}"
								Margin="0,5"
								ToolTip="{Binding [MindMapsDashboard], Source={StaticResource Loc}}">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<TextBlock Text="🗺" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
								<TextBlock Style="{StaticResource SidebarLabelTextStyle}" Text="{Binding [MindMapsDashboard], Source={StaticResource Loc}}"/>
							</StackPanel>
						</Button>

                        <Button Style="{StaticResource SidebarQuizzesDashboardButtonStyle}"
								Command="{Binding ShowQuizzesCommand}"
								Margin="0,5"
								ToolTip="{Binding [QuizzesDashboard], Source={StaticResource Loc}}">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Grid Width="20" Height="20" VerticalAlignment="Center">
                                    <Border Width="16"
                                            Height="16"
                                            Background="Transparent"
                                            BorderBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            BorderThickness="0.8"
                                            CornerRadius="3"
                                            VerticalAlignment="Center"
                                            HorizontalAlignment="Center">
                                        <TextBlock Text="✓"
                                                    FontSize="10"
                                                    FontWeight="SemiBold"
                                                    Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                    TextAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"/>
                                    </Border>
                                </Grid>
								<TextBlock Style="{StaticResource SidebarLabelTextStyle}" Text="{Binding [QuizzesDashboard], Source={StaticResource Loc}}"/>
							</StackPanel>
						</Button>
                        <Separator Margin="6,10,6,10"/>

                        <Button Style="{StaticResource SidebarActionButtonStyle}"
								Click="SidebarSettingsButton_Click"
								ToolTip="{Binding [Settings], Source={StaticResource Loc}}">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<TextBlock Text="⚙" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
								<TextBlock Style="{StaticResource SidebarLabelTextStyle}" Text="{Binding [Settings], Source={StaticResource Loc}}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource SidebarActionButtonStyle}"
								Click="AboutButton_Click"
								ToolTip="{Binding [About], Source={StaticResource Loc}}">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<TextBlock Text="ℹ" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
								<TextBlock Style="{StaticResource SidebarLabelTextStyle}" Text="{Binding [About], Source={StaticResource Loc}}"/>
							</StackPanel>
						</Button>
					</StackPanel>
				</ScrollViewer>
			</Grid>
		</Border>


		<Grid Grid.Column="1">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- Top Bar -->
			<Border Grid.Row="0"
					Background="{DynamicResource SidebarBackground}"
					BorderBrush="{DynamicResource BorderColor}"
					BorderThickness="0,0,0,1"
					Padding="16,10">
				<Grid>
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                     <Image Source="/NoteCards;component/logo.ico"
                               Width="28"
                               Height="28"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>

						<TextBlock Text="NoteCards"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   VerticalAlignment="Center"/>

					</StackPanel>
					<Grid HorizontalAlignment="Right"
						  VerticalAlignment="Center">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
                           <ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<Border x:Name="TopSearchPanel"
								Grid.Column="0"
								Width="0"
								Height="34"
								Margin="0,0,8,0"
								Padding="10,0"
								Visibility="Collapsed"
                                Background="{DynamicResource CardBackground}"
								BorderBrush="{DynamicResource BorderColor}"
								BorderThickness="1"
								CornerRadius="8"
								Opacity="0">
							<DockPanel LastChildFill="True">
                              <TextBlock Text="🔎"
                                    Foreground="{DynamicResource TextColorSecondary}"
										   Margin="0,0,8,0"
                                        VerticalAlignment="Center"
										   FontSize="13"/>
								<TextBox x:Name="TopSearchTextBox"
										 BorderThickness="0"
										 Background="Transparent"
										 Foreground="{DynamicResource TextColor}"
										 CaretBrush="{DynamicResource TextColor}"
 										 VerticalContentAlignment="Center"
 										 Text="{Binding ActiveSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
 										 ToolTip="{Binding [SearchNotesHint], Source={StaticResource Loc}}"
										 KeyDown="TopSearchTextBox_KeyDown"/>
							</DockPanel>
						</Border>

						<Button x:Name="TopSearchButton"
								Grid.Column="1"
                                Style="{StaticResource TopBarIconButtonStyle}"
                              Content="🔎"
                               FontSize="14"
								Margin="0,0,8,0"
								ToolTip="{Binding [Search], Source={StaticResource Loc}}"
								Click="TopSearchButton_Click"/>

						<Button x:Name="SortNotesButton"
								Grid.Column="2"
                             Style="{StaticResource TopBarIconButtonStyle}"
								Content="⇅"
								FontSize="14"
								Margin="0,0,8,0"
								ToolTip="{Binding ActiveSortButtonText}"
								Click="SortNotesButton_Click"/>

						<Button x:Name="TagsFilterButton"
							 Grid.Column="3"
                              Style="{StaticResource TopBarIconButtonStyle}"
							  Content="🏷"
							   FontSize="14"
								Margin="0,0,8,0"
								ToolTip="{Binding ActiveTagFilterButtonText}"
								Click="TagsFilterButton_Click"/>

						<Button x:Name="DashboardSectionsButton"
								Grid.Column="4"
								Style="{StaticResource TopBarIconButtonStyle}"
								Content="☷"
								FontSize="14"
								Margin="0,0,8,0"
                                ToolTip="{Binding [DashboardSections], Source={StaticResource Loc}}"
								Click="DashboardSectionsButton_Click"/>

					</Grid>
				</Grid>
			</Border>

			<Popup x:Name="SortNotesPopup"
				   Grid.Row="0"
				   PlacementTarget="{Binding ElementName=SortNotesButton}"
				   Placement="Bottom"
				   StaysOpen="False"
				   AllowsTransparency="True"
				   PopupAnimation="Fade">
				<Border Background="{DynamicResource SidebarBackground}"
						BorderBrush="{DynamicResource BorderColor}"
						BorderThickness="1"
						CornerRadius="10"
						MinWidth="260"
						MaxWidth="320"
						Padding="8"
						Margin="12,10,12,14">
					<Border.Effect>
						<DropShadowEffect Color="#000000" Opacity="0.14" BlurRadius="14" ShadowDepth="1" Direction="270"/>
					</Border.Effect>
					<StackPanel>
						<TextBlock Text="{Binding ActiveSortButtonText}"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource TextColor}"
								   Margin="6,3,6,8"/>
						<Border Background="{DynamicResource CardBackground}"
								CornerRadius="8"
								Padding="8,8">
							<ItemsControl ItemsSource="{Binding ActiveSortOptions}">
								<ItemsControl.ItemTemplate>
                                   <DataTemplate>
										<RadioButton GroupName="NoteSortOptionGroup"
												 Content="{Binding DisplayName}"
												 IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												 Margin="2,4"
												 Foreground="{DynamicResource TextColor}"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Border>
					</StackPanel>
				</Border>
			</Popup>

			<Popup x:Name="DashboardSectionsPopup"
				   Grid.Row="0"
				   PlacementTarget="{Binding ElementName=DashboardSectionsButton}"
				   Placement="Bottom"
				   StaysOpen="False"
				   AllowsTransparency="True"
				   PopupAnimation="Fade">
				<Border Background="{DynamicResource SidebarBackground}"
						BorderBrush="{DynamicResource BorderColor}"
						BorderThickness="1"
						CornerRadius="10"
						MinWidth="220"
						MaxWidth="300"
						Padding="8"
						Margin="12,10,12,14">
					<Border.Effect>
						<DropShadowEffect Color="#000000" Opacity="0.14" BlurRadius="14" ShadowDepth="1" Direction="270"/>
					</Border.Effect>
					<StackPanel>
						<TextBlock Text="{Binding [DashboardSections], Source={StaticResource Loc}}"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource TextColor}"
								   Margin="6,3,6,8"/>
						<Border Background="{DynamicResource CardBackground}"
								CornerRadius="8"
								Padding="10,10">
                            <Grid>
							<StackPanel Visibility="{Binding IsNotesView, Converter={StaticResource BoolToVis}}">
								<CheckBox Content="{Binding [RecentNotes], Source={StaticResource Loc}}"
										  IsChecked="{Binding IsRecentSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										  Margin="0,0,0,6"
										  Foreground="{DynamicResource TextColor}"/>
                             <CheckBox Content="{Binding [CalendarSection], Source={StaticResource Loc}}"
										  IsChecked="{Binding IsCalendarSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										  Margin="0,0,0,6"
										  Foreground="{DynamicResource TextColor}"/>
								<CheckBox Content="{Binding [Groups], Source={StaticResource Loc}}"
										  IsChecked="{Binding IsGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										  Margin="0,0,0,6"
										  Foreground="{DynamicResource TextColor}"/>
								<CheckBox Content="{Binding [UngroupedNotes], Source={StaticResource Loc}}"
										  IsChecked="{Binding IsUngroupedSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										  Foreground="{DynamicResource TextColor}"/>
							</StackPanel>
                            <StackPanel Visibility="{Binding IsFlashcardsView, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="{Binding [CalendarSection], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsCalendarSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [FlashcardGroupsDashboardTitle], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsFlashcardGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsQuizzesView, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="{Binding [CalendarSection], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsCalendarSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                            <StackPanel Visibility="{Binding IsMindMapsView, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="{Binding [CalendarSection], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsCalendarSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Margin="0,0,0,6"
                                          Foreground="{DynamicResource TextColor}"/>
                                <CheckBox Content="{Binding [MindMapsDashboardTitle], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsMindMapGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                            </Grid>
						</Border>
					</StackPanel>
				</Border>
			</Popup>

			<Popup x:Name="TagsFilterPopup"
				   Grid.Row="0"
				   PlacementTarget="{Binding ElementName=TagsFilterButton}"
				   Placement="Bottom"
				   StaysOpen="False"
				   AllowsTransparency="True"
				   PopupAnimation="Fade">
				<Border Background="{DynamicResource SidebarBackground}"
						BorderBrush="{DynamicResource BorderColor}"
						BorderThickness="1"
						CornerRadius="10"
						MinWidth="260"
						MaxWidth="320"
						Padding="8"
						Margin="12,10,12,14">
					<Border.Effect>
						<DropShadowEffect Color="#000000" Opacity="0.14" BlurRadius="14" ShadowDepth="1" Direction="270"/>
					</Border.Effect>
					<StackPanel>
						<Grid Margin="4,2,4,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<TextBlock Text="{Binding [FilterTags], Source={StaticResource Loc}}"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource TextColor}"
									   VerticalAlignment="Center"/>
							<Button Grid.Column="1"
									Style="{StaticResource PopupMenuButtonStyle}"
									Padding="8,4"
									Content="{Binding [ClearFilters], Source={StaticResource Loc}}"
									Command="{Binding ClearTagFiltersCommand}"/>
						</Grid>
						<Border Background="{DynamicResource CardBackground}"
								CornerRadius="8"
								Padding="10,14"
								Visibility="{Binding ActiveHasTagFilters, Converter={StaticResource BoolToVis}}">
							<ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
								<ItemsControl ItemsSource="{Binding ActiveTagFilters}">
									<ItemsControl.ItemTemplate>
										<DataTemplate DataType="{x:Type vm:TagFilterItemViewModel}">
											<CheckBox Content="{Binding Tag}"
													  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													  Margin="0,2"
													  Foreground="{DynamicResource TextColor}"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</Border>
                      <TextBlock Text="{Binding [NoTagsFound], Source={StaticResource Loc}}"
								   Margin="4,8,4,6"
								   FontStyle="Italic"
								   Foreground="{DynamicResource TextColorSecondary}">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Visibility" Value="Collapsed"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding ActiveHasTagFilters}" Value="False">
											<Setter Property="Visibility" Value="Visible"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</StackPanel>
				</Border>
			</Popup>

			<!-- Dashboard + FAB overlay -->
            <Grid Grid.Row="1">
                
                <!-- NOTES VIEW -->
                <Grid Visibility="{Binding IsNotesView, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Recent Notes strip -->
                    <Border Grid.Row="0"
                        Visibility="{Binding IsRecentSectionVisible, Converter={StaticResource BoolToVis}}"
						Background="{DynamicResource SidebarBackground}"
						BorderBrush="{DynamicResource BorderColor}"
                       BorderThickness="0,0,0,1"
						Padding="16,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
									ToolTip="{Binding [ToggleRecentNotesSection], Source={StaticResource Loc}}"
									Click="ToggleRecentSectionButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DashboardSectionToggleButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecentSectionExpanded}" Value="False">
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="-90"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Grid.Column="1"
									   Text="{Binding [RecentNotes], Source={StaticResource Loc}}"
									   FontSize="13"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource TextColor}"
									Margin="8,0,0,0"
									   FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
									   VerticalAlignment="Center"/>
                            </Grid>
                            <Border x:Name="RecentSectionBody"
								Margin="0,10,0,0"
								RenderTransformOrigin="0.5,0">
                                <Border.RenderTransform>
                                    <TranslateTransform/>
                                </Border.RenderTransform>
                                <ScrollViewer x:Name="RecentNotesScrollViewer"
										  HorizontalScrollBarVisibility="Auto"
										  VerticalScrollBarVisibility="Disabled"
										  CanContentScroll="True"
										  PanningMode="HorizontalOnly"
										  PreviewMouseWheel="RecentNotesScrollViewer_PreviewMouseWheel">
                                    <ItemsControl ItemsSource="{Binding RecentNotes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:NoteCardViewModel}">
                                                <Button Style="{StaticResource RecentNoteCardStyle}"
													Tag="{Binding}"
													Click="RecentNoteButton_Click">
                                                    <StackPanel MinWidth="120" MaxWidth="180">
                                                        <TextBlock Text="{Binding Document.Title}"
															   FontWeight="SemiBold"
															   FontSize="13"
															   TextTrimming="CharacterEllipsis"
															   Foreground="{DynamicResource TextColor}"/>
                                                        <TextBlock Text="{Binding Document.LastModified, StringFormat='{}{0:dd MMM, HH:mm}'}"
															   FontSize="11"
															   Foreground="{DynamicResource TextColor}"
															   Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- All Notes + FAB -->
                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="NotesScrollViewer"
								 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
								 Padding="8"
								 AllowDrop="True"
								 PreviewDragOver="NotesScrollViewer_PreviewDragOver"
								 PreviewMouseWheel="NotesScrollViewer_PreviewMouseWheel">
                            <Grid Margin="0,0,0,18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border x:Name="CalendarSectionContainer"
									Visibility="{Binding IsCalendarSectionVisible, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource SidebarBackground}"
									BorderBrush="{DynamicResource BorderColor}"
									BorderThickness="0"
                                    CornerRadius="14"
									Padding="12"
									Margin="8,0,8,10"
									RenderTransformOrigin="0.5,0.5">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="14" ShadowDepth="1" Direction="270"/>
                                    </Border.Effect>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Grid.Row" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCalendarFirst}" Value="False">
                                                    <Setter Property="Grid.Row" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid Margin="2,0,2,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                Style="{StaticResource DashboardSectionMoveButtonStyle}"
												Content="↑"
												Margin="0,0,2,0"
												ToolTip="{Binding [MoveCalendarSectionUp], Source={StaticResource Loc}}"
												Click="MoveCalendarUpButton_Click"/>
                                            <Button Grid.Column="1"
												Style="{StaticResource DashboardSectionMoveButtonStyle}"
												Content="↓"
												Margin="0,0,4,0"
												ToolTip="{Binding [MoveCalendarSectionDown], Source={StaticResource Loc}}"
												Click="MoveCalendarDownButton_Click"/>
                                            <Button Grid.Column="2"
												ToolTip="{Binding [ToggleCalendarSection], Source={StaticResource Loc}}"
												Click="ToggleCalendarSectionButton_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource DashboardSectionToggleButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCalendarSectionExpanded}" Value="False">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="-90"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <TextBlock Grid.Column="3"
												   Text="{Binding [CalendarSection], Source={StaticResource Loc}}"
												   FontSize="14"
												   FontWeight="SemiBold"
												   Foreground="{DynamicResource TextColor}"
												   Margin="8,0,0,0"
												   VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid x:Name="CalendarSectionBody" Margin="2,0,2,2" Height="220">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="210"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0"
												Background="{DynamicResource CardBackground}"
												BorderBrush="{DynamicResource BorderColor}"
                                             BorderThickness="0"
                                               CornerRadius="12"
                                               Padding="8">
                                                <Calendar x:Name="DashboardCalendar"
                                              Style="{StaticResource DashboardCalendarControlStyle}"
													 SelectedDate="{Binding CalendarSelectedDate, Mode=TwoWay}"
													 SelectionMode="SingleDate"
													 SelectedDatesChanged="DashboardCalendar_SelectedDatesChanged"/>
                                            </Border>
                                            <Border Grid.Column="2"
												Background="{DynamicResource CardBackground}"
												BorderBrush="{DynamicResource BorderColor}"
												BorderThickness="0"
                                               CornerRadius="12"
                                                Padding="8"
                                               ClipToBounds="True"
                                               Height="220">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding CalendarSelectedDateDisplay}"
														   FontWeight="SemiBold"
														   Foreground="{DynamicResource TextColor}"
                                                      Margin="2,2,2,8"/>
                                                    <Grid Grid.Row="1">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="146">
                                                            <ItemsControl ItemsSource="{Binding CalendarScheduledNotes}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:CalendarScheduledItemViewModel}">
                                                                        <Border Style="{StaticResource CalendarScheduledItemCardStyle}"
												Tag="{Binding}"
												MouseLeftButtonUp="CalendarScheduledItemCard_MouseLeftButtonUp">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="Auto"/>
                                                                                </Grid.ColumnDefinitions>
                                                                                <Button x:Name="CalendarScheduleGearButton"
														Grid.Column="0"
                                                     Content="✎"
														Style="{StaticResource TopBarIconButtonStyle}"
														Width="30"
														Height="30"
														Margin="0,0,10,0"
														VerticalAlignment="Center"
														Tag="{Binding}"
														ToolTip="{Binding [CalendarEditSchedule], Source={StaticResource Loc}}"
														Click="CalendarScheduleGearButton_Click"/>
                                                                                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                                                                                    <TextBlock Text="{Binding Title}"
															   FontWeight="SemiBold"
															   Foreground="{DynamicResource TextColor}"
															   TextTrimming="CharacterEllipsis"
															   VerticalAlignment="Center"
															   Margin="0,0,0,6"/>
                                                                                    <TextBlock Text="{Binding ScheduleNote}"
														   TextWrapping="Wrap"
														   MaxHeight="34"
														   Foreground="{DynamicResource TextColorSecondary}">
                                                                                        <TextBlock.Style>
                                                                                            <Style TargetType="TextBlock">
                                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                                                <Style.Triggers>
                                                                                                    <Trigger Property="Text" Value="">
                                                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                                                    </Trigger>
                                                                                                </Style.Triggers>
                                                                                            </Style>
                                                                                        </TextBlock.Style>
                                                                                    </TextBlock>
                                                                                </StackPanel>
                                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                                                    <Border Background="{DynamicResource SelectionBackground}"
																BorderBrush="{DynamicResource BorderColor}"
																BorderThickness="1"
																CornerRadius="8"
																Padding="6,2"
																Margin="0,0,4,0"
																VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding TypeIcon}" FontSize="11" Foreground="{DynamicResource TextColor}"/>
                                                                                    </Border>
                                                                                    <Border Background="{DynamicResource SelectionBackground}"
																BorderBrush="{DynamicResource BorderColor}"
																BorderThickness="1"
																CornerRadius="8"
																Padding="8,2"
																VerticalAlignment="Center">
                                                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                                            <TextBlock Text="🕒" Margin="0,0,4,0" FontSize="10" VerticalAlignment="Center"/>
                                                                                            <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{DynamicResource TextColor}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </StackPanel>
                                                                            </Grid>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                        <TextBlock Text="{Binding [CalendarNoSchedulesForDay], Source={StaticResource Loc}}"
														   Foreground="{DynamicResource TextColorSecondary}"
														   FontStyle="Italic"
														   TextWrapping="Wrap"
														   HorizontalAlignment="Center"
														   VerticalAlignment="Center"
														   TextAlignment="Center"
														   Margin="10,10,10,10">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasCalendarScheduledNotes}" Value="False">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="GroupsSectionContainer"
									Margin="0,0,0,10"
									RenderTransformOrigin="0.5,0.5">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Setter Property="Grid.Row" Value="1"/>
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasGroups}" Value="True"/>
                                                        <Condition Binding="{Binding IsGroupsSectionVisible}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </MultiDataTrigger>
                                                <DataTrigger Binding="{Binding IsGroupsFirst}" Value="False">
                                                    <Setter Property="Grid.Row" Value="2"/>
                                                </DataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsCalendarFirst}" Value="False"/>
                                                        <Condition Binding="{Binding IsGroupsFirst}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Grid.Row" Value="0"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding IsCalendarFirst}" Value="False"/>
                                                        <Condition Binding="{Binding IsGroupsFirst}" Value="False"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Grid.Row" Value="1"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.RenderTransform>
                                        <TranslateTransform/>
                                    </Border.RenderTransform>
                                    <StackPanel>
                                        <Grid Margin="10,6,10,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Style="{StaticResource DashboardSectionMoveButtonStyle}" Margin="0,0,2,0" Content="↑" ToolTip="{Binding [MoveGroupsSectionUp], Source={StaticResource Loc}}" Click="MoveGroupsUpButton_Click"/>
                                            <Button Grid.Column="1" Style="{StaticResource DashboardSectionMoveButtonStyle}" Margin="0,0,4,0" Content="↓" ToolTip="{Binding [MoveGroupsSectionDown], Source={StaticResource Loc}}" Click="MoveGroupsDownButton_Click"/>
                                            <Button Grid.Column="2" ToolTip="{Binding [ToggleGroupsSection], Source={StaticResource Loc}}" Click="ToggleGroupsSectionButton_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource DashboardSectionToggleButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsGroupsSectionExpanded}" Value="False">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="-90"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <TextBlock Grid.Column="3"
												   Text="{Binding [Groups], Source={StaticResource Loc}}"
												   FontSize="14"
												   FontWeight="SemiBold"
												   Foreground="{DynamicResource TextColor}"
												Margin="8,0,0,0"
												   VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel x:Name="GroupsSectionBody">
                                            <ItemsControl x:Name="GroupsItemsControl" ItemsSource="{Binding NoteGroups}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:NoteGroupViewModel}">
                                                        <Border Style="{StaticResource GroupCardStyle}"
													Background="{Binding BackgroundBrush}"
													BorderBrush="{DynamicResource BorderColor}"
													BorderThickness="1"
													CornerRadius="12"
													Padding="10"
													Margin="8,0,8,10"
													AllowDrop="True"
													DragOver="GroupBorder_DragOver"
													Drop="GroupBorder_Drop">
                                                            <Border.Tag>
                                                                <Binding/>
                                                            </Border.Tag>
                                                            <StackPanel>
                                                                <Grid Margin="2,0,2,8">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button Grid.Column="0"
															Style="{StaticResource GroupHeaderMoveButtonStyle}"
															Content="↑"
															Margin="0,0,3,0"
															Tag="{Binding}"
                                            ToolTip="{Binding [MoveThisGroupUp], Source={StaticResource Loc}}"
															Click="MoveSingleGroupUpButton_Click"/>
                                                                    <Button Grid.Column="1"
															Style="{StaticResource GroupHeaderMoveButtonStyle}"
															Content="↓"
															Margin="0,0,4,0"
															Tag="{Binding}"
                                          ToolTip="{Binding [MoveThisGroupDown], Source={StaticResource Loc}}"
															Click="MoveSingleGroupDownButton_Click"/>
                                                                    <Button Grid.Column="2"
                                                            Style="{StaticResource GroupHeaderIconButtonStyle}"
																FontSize="13"
																Content="🎨"
																Margin="0,0,4,0"
																Tag="{Binding}"
																ToolTip="{Binding [GroupBackgroundColor], Source={StaticResource Loc}}"
																Click="GroupColorButton_Click">
                                                                        <Button.ContextMenu>
                                                                            <ContextMenu>
                                                                                <MenuItem Header="{Binding [GroupColorDefault], Source={StaticResource Loc}}" Tag="#F8FAFF" Click="GroupColorMenuItem_Click"/>
