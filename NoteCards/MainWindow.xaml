<Window x:Class="NoteCards.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:NoteCards.Controls"
        xmlns:vm="clr-namespace:NoteCards.ViewModels"
        xmlns:Views="clr-namespace:NoteCards.Views"
        xmlns:converters="clr-namespace:NoteCards.Converters"
        Title="NoteCards" Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackground}"
		UseLayoutRounding="True"
		SnapsToDevicePixels="True"
		TextOptions.TextFormattingMode="Display"
		TextOptions.TextRenderingMode="ClearType">

    <Window.Resources>
        <converters:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
        <Style x:Key="RecentNoteCardStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Background" Value="{DynamicResource CardBackground}"/>
			<Setter Property="Padding" Value="12,10"/>
			<Setter Property="Margin" Value="0,0,8,0"/>
			<Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="CardBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{DynamicResource BorderColor}"
								BorderThickness="1"
								CornerRadius="8"
								Padding="{TemplateBinding Padding}">
							<Border.Effect>
								<DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.08"/>
							</Border.Effect>
                         <ContentPresenter Content="{TemplateBinding Content}"
											  ContentTemplate="{TemplateBinding ContentTemplate}"
											  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
											  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="CardBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<DataTrigger Binding="{Binding DataContext.IsMassSelectMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
					<Setter Property="Opacity" Value="0.55"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="CalendarScheduledItemCardStyle" TargetType="Border">
			<Setter Property="Background" Value="{DynamicResource CardBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="CornerRadius" Value="12"/>
			<Setter Property="Padding" Value="11"/>
			<Setter Property="Margin" Value="0,0,0,8"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="10" ShadowDepth="1" Direction="270"/>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
					<Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
				</Trigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="CalendarScheduledItemButtonStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
         <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
           <Setter Property="Padding" Value="12,10"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="ScheduledItemBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
								Padding="{TemplateBinding Padding}"
								Margin="1">
                            <Border.Effect>
								<DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="8" ShadowDepth="1" Direction="270"/>
							</Border.Effect>
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
											  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="ScheduledItemBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
								<Setter TargetName="ScheduledItemBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="ScheduledItemBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
                              <Setter TargetName="ScheduledItemBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="MassActionIconButtonStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Width" Value="34"/>
			<Setter Property="Height" Value="34"/>
			<Setter Property="Margin" Value="0,0,6,0"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
			<Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource IconButtonBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="MassActionBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="9">
							<Border.Effect>
								<DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08"/>
							</Border.Effect>
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="MassActionBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
								<Setter TargetName="MassActionBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="MassActionBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
								<Setter TargetName="MassActionBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Opacity" Value="0.45"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="TopBarIconButtonStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
			<Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource IconButtonBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Width" Value="34"/>
			<Setter Property="Height" Value="32"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="TopBarIconBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="8">
							<Border.Effect>
								<DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08"/>
							</Border.Effect>
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="TopBarIconBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
								<Setter TargetName="TopBarIconBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="TopBarIconBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
								<Setter TargetName="TopBarIconBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsMassSelectMode}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
					<Setter Property="Opacity" Value="0.55"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="FloatingSecondaryButtonStyle" TargetType="Button" BasedOn="{StaticResource TopBarIconButtonStyle}">
			<Setter Property="Width" Value="36"/>
			<Setter Property="Height" Value="34"/>
			<Setter Property="FontSize" Value="15"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="FloatingSecondaryBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="10">
							<Border.Effect>
								<DropShadowEffect Color="#000000" Opacity="0.20" BlurRadius="16" ShadowDepth="3" Direction="270"/>
							</Border.Effect>
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="FloatingSecondaryBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
								<Setter TargetName="FloatingSecondaryBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="FloatingSecondaryBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
								<Setter TargetName="FloatingSecondaryBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
            <Style.Triggers>
				<DataTrigger Binding="{Binding IsMassSelectMode}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
					<Setter Property="Opacity" Value="0.55"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarActionButtonStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Margin" Value="0,0,0,6"/>
			<Setter Property="Padding" Value="10,8"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="SidebarButtonBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="10"
								Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
											  VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SidebarButtonBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
								<Setter TargetName="SidebarButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SidebarButtonBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
								<Setter TargetName="SidebarButtonBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
								<Setter Property="HorizontalContentAlignment" Value="Center"/>
								<Setter Property="Padding" Value="0"/>
								<Setter Property="Height" Value="38"/>
							</DataTrigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
            <Style.Triggers>
				<DataTrigger Binding="{Binding DataContext.IsMassSelectMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
					<Setter Property="IsEnabled" Value="False"/>
					<Setter Property="Opacity" Value="0.55"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="SidebarLabelTextStyle" TargetType="TextBlock">
			<Setter Property="Margin" Value="10,0,0,0"/>
			<Setter Property="VerticalAlignment" Value="Center"/>
			<Setter Property="TextTrimming" Value="CharacterEllipsis"/>
			<Style.Triggers>
				<DataTrigger Binding="{Binding IsSidebarExpanded}" Value="False">
					<Setter Property="Visibility" Value="Collapsed"/>
				</DataTrigger>
			</Style.Triggers>
		</Style>
		
		
        <converters:BoolToScrollBarVisibilityConverter x:Key="BoolToScrollBarVisibilityConverter" />
        <ItemsPanelTemplate x:Key="UngroupedGridItemsPanel">
			<WrapPanel Orientation="Horizontal"/>
		</ItemsPanelTemplate>
		<ItemsPanelTemplate x:Key="UngroupedListItemsPanel">
			<StackPanel Orientation="Vertical"/>
		</ItemsPanelTemplate>
		<Style x:Key="PopupMenuButtonStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="HorizontalContentAlignment" Value="Stretch"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Padding" Value="12,9"/>
			<Setter Property="FontSize" Value="14"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type Button}">
						<Border x:Name="PopupItemBorder"
								Background="{TemplateBinding Background}"
								CornerRadius="6"
								Padding="{TemplateBinding Padding}"
								Margin="2">
							<TextBlock Text="{TemplateBinding Content}"
									   Foreground="{TemplateBinding Foreground}"
									   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="PopupItemBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="PopupItemBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
								<Setter Property="Opacity" Value="0.6"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="FabStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="SnapsToDevicePixels" Value="True"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
			<Setter Property="FontSize" Value="26"/>
			<Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
			<Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource IconButtonBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Width" Value="52"/>
			<Setter Property="Height" Value="52"/>
			<Setter Property="HorizontalContentAlignment" Value="Center"/>
			<Setter Property="VerticalContentAlignment" Value="Center"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type Button}">
						<Border x:Name="FabBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="14">
							<Border.Effect>
								<DropShadowEffect Color="#000000" Opacity="0.20"
												  BlurRadius="16" ShadowDepth="3"
												  Direction="270"/>
							</Border.Effect>
							<TextBlock Text="{TemplateBinding Content}"
									   Foreground="{TemplateBinding Foreground}"
									   HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
									   VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
									   Margin="0,-3,0,0"
									   FontSize="{TemplateBinding FontSize}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="FabBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
								<Setter TargetName="FabBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="FabBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
								<Setter TargetName="FabBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
						   <Trigger Property="IsEnabled" Value="False">
								<Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
								<Setter TargetName="FabBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
								<Setter TargetName="FabBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
								<Setter TargetName="FabBorder" Property="Opacity" Value="0.62"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="GroupCardStyle" TargetType="Border">
			<Setter Property="Opacity" Value="0"/>
			<Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
			<Setter Property="RenderTransform">
				<Setter.Value>
					<TranslateTransform Y="10"/>
				</Setter.Value>
			</Setter>
			<Style.Triggers>
				<EventTrigger RoutedEvent="Loaded">
					<BeginStoryboard>
						<Storyboard>
							<DoubleAnimation Storyboard.TargetProperty="Opacity"
											 To="1"
											 Duration="0:0:0.25"/>
							<DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
											 To="0"
											 Duration="0:0:0.25">
								<DoubleAnimation.EasingFunction>
									<CubicEase EasingMode="EaseOut"/>
								</DoubleAnimation.EasingFunction>
							</DoubleAnimation>
						</Storyboard>
					</BeginStoryboard>
				</EventTrigger>
			</Style.Triggers>
		</Style>

		<Style x:Key="DashboardSectionToggleButtonStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Width" Value="30"/>
			<Setter Property="Height" Value="30"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource IconButtonBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="Content" Value="▾"/>
			<Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
			<Setter Property="RenderTransform">
				<Setter.Value>
					<RotateTransform Angle="0"/>
				</Setter.Value>
			</Setter>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="ToggleBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="9">
							<Border.Effect>
								<DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.08"/>
							</Border.Effect>
							<TextBlock Text="{TemplateBinding Content}"
									   Foreground="{TemplateBinding Foreground}"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center"
									   Margin="0,-1,0,0"
									   FontSize="{TemplateBinding FontSize}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
								<Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
								<Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
						 <Trigger Property="IsEnabled" Value="False">
								<Setter Property="Foreground" Value="{DynamicResource TextColorSecondary}"/>
								<Setter TargetName="ToggleBorder" Property="Background" Value="{DynamicResource SelectionBackground}"/>
								<Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
								<Setter TargetName="ToggleBorder" Property="Opacity" Value="0.65"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DashboardSectionMoveButtonStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Width" Value="28"/>
			<Setter Property="Height" Value="28"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="FontSize" Value="12"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Background" Value="{DynamicResource IconButtonBackground}"/>
			<Setter Property="BorderBrush" Value="{DynamicResource IconButtonBorder}"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="{DynamicResource IconButtonForeground}"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="MoveBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="8">
							<Border.Effect>
								<DropShadowEffect BlurRadius="7" ShadowDepth="1" Opacity="0.07"/>
							</Border.Effect>
							<TextBlock Text="{TemplateBinding Content}"
									   Foreground="{TemplateBinding Foreground}"
									   HorizontalAlignment="Center"
									   VerticalAlignment="Center"
									   Margin="0,-1,0,0"
									   FontWeight="{TemplateBinding FontWeight}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="MoveBorder" Property="Background" Value="{DynamicResource IconButtonHoverBackground}"/>
								<Setter TargetName="MoveBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="MoveBorder" Property="Background" Value="{DynamicResource IconButtonPressedBackground}"/>
								<Setter TargetName="MoveBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="GroupHeaderMoveButtonStyle" TargetType="Button" BasedOn="{StaticResource DashboardSectionMoveButtonStyle}">
			<Setter Property="Width" Value="24"/>
			<Setter Property="Height" Value="24"/>
			<Setter Property="FontSize" Value="11"/>
		</Style>

		<Style x:Key="GroupHeaderIconButtonStyle" TargetType="Button">
			<Setter Property="OverridesDefaultStyle" Value="True"/>
			<Setter Property="Width" Value="28"/>
			<Setter Property="Height" Value="28"/>
			<Setter Property="Padding" Value="0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="Background" Value="#F5F7FB"/>
			<Setter Property="BorderBrush" Value="#DDE4F3"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="Foreground" Value="#4B5878"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="GroupIconBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="8">
							<Border.Effect>
								<DropShadowEffect BlurRadius="7" ShadowDepth="1" Opacity="0.07"/>
							</Border.Effect>
							<ContentPresenter HorizontalAlignment="Center"
											  VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="GroupIconBorder" Property="Background" Value="#EAF0FD"/>
								<Setter TargetName="GroupIconBorder" Property="BorderBrush" Value="#C9D7F5"/>
							</Trigger>
							<Trigger Property="IsPressed" Value="True">
								<Setter TargetName="GroupIconBorder" Property="Background" Value="#DCE7FB"/>
								<Setter TargetName="GroupIconBorder" Property="BorderBrush" Value="#B8CAF2"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DashboardCalendarDayButtonStyle" TargetType="CalendarDayButton">
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderBrush" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="1"/>
           <Setter Property="Margin" Value="1"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="CalendarDayButton">
						<Border x:Name="DayBorder"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
								Padding="3">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="DayBorder" Property="Background" Value="{DynamicResource HoverBackground}"/>
								<Setter TargetName="DayBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
							</Trigger>
							<Trigger Property="IsSelected" Value="True">
                              <Setter TargetName="DayBorder" Property="Background" Value="#3F6FE8"/>
								<Setter TargetName="DayBorder" Property="BorderBrush" Value="#2F5CD0"/>
								<Setter Property="Foreground" Value="White"/>
							</Trigger>
							<Trigger Property="IsInactive" Value="True">
								<Setter Property="Opacity" Value="0.45"/>
							</Trigger>
							<Trigger Property="IsToday" Value="True">
                             <Setter TargetName="DayBorder" Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
								<Setter TargetName="DayBorder" Property="BorderThickness" Value="2"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<Style x:Key="DashboardCalendarControlStyle" TargetType="Calendar">
			<Setter Property="Background" Value="Transparent"/>
			<Setter Property="BorderThickness" Value="0"/>
			<Setter Property="Foreground" Value="{DynamicResource TextColor}"/>
			<Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
              <Setter Property="Padding" Value="4"/>
			<Setter Property="CalendarDayButtonStyle" Value="{StaticResource DashboardCalendarDayButtonStyle}"/>
            <Setter Property="FontSize" Value="13"/>
		</Style>
	</Window.Resources>
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
	<Grid>

		<Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="SidebarColumn" Width="64"/>
			<ColumnDefinition Width="*"/>
		</Grid.ColumnDefinitions>

		<!-- Sidebar -->
     <Border Grid.Column="0"
				Background="{DynamicResource SidebarBackground}"
				BorderBrush="#E0E0E0"
				BorderThickness="0,0,1,0"
             IsEnabled="{Binding IsNotMassSelectMode}"
				Padding="8,10">
			<Grid>
				<Grid.RowDefinitions>
					<RowDefinition Height="Auto"/>
					<RowDefinition Height="*"/>
				</Grid.RowDefinitions>

				<Button Command="{Binding ToggleSidebarCommand}"
						Style="{StaticResource SidebarActionButtonStyle}"
						Margin="0,0,0,10"
						ToolTip="{Binding [Menu], Source={StaticResource Loc}}">
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<TextBlock Text="☰" FontSize="16" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
						<TextBlock Style="{StaticResource SidebarLabelTextStyle}"
								   Text="{Binding [Menu], Source={StaticResource Loc}}"
								   FontWeight="SemiBold"/>
					</StackPanel>
				</Button>

				<ScrollViewer Grid.Row="1"
							  VerticalScrollBarVisibility="Auto"
							  HorizontalScrollBarVisibility="Disabled">
					<StackPanel>
						<Button Style="{StaticResource SidebarActionButtonStyle}"
								Click="SidebarAddButton_Click">
							<Button.ToolTip>
								<TextBlock>
									<TextBlock.Style>
										<Style TargetType="TextBlock">
											<Setter Property="Text" Value="{Binding [AddNote], Source={StaticResource Loc}}"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsFlashcardsView}" Value="True">
													<Setter Property="Text" Value="{Binding [CreateFlashcards], Source={StaticResource Loc}}"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
							</Button.ToolTip>
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<TextBlock Text="➕" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
								<TextBlock>
									<TextBlock.Style>
										<Style TargetType="TextBlock" BasedOn="{StaticResource SidebarLabelTextStyle}">
											<Setter Property="Text" Value="{Binding [AddNote], Source={StaticResource Loc}}"/>
											<Style.Triggers>
												<DataTrigger Binding="{Binding IsFlashcardsView}" Value="True">
													<Setter Property="Text" Value="{Binding [CreateFlashcards], Source={StaticResource Loc}}"/>
												</DataTrigger>
											</Style.Triggers>
										</Style>
									</TextBlock.Style>
								</TextBlock>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource SidebarActionButtonStyle}"
								Click="ImportButton_Click"
								ToolTip="{Binding [ImportNotes], Source={StaticResource Loc}}"
								Visibility="{Binding IsFlashcardsView, Converter={StaticResource InverseBoolToVisibilityConverter}}">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<TextBlock Text="📥" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
								<TextBlock Style="{StaticResource SidebarLabelTextStyle}" Text="{Binding [ImportNotes], Source={StaticResource Loc}}"/>
							</StackPanel>
						</Button>

						<Separator Margin="6,10,6,10"/>
						<Button Style="{StaticResource SidebarActionButtonStyle}"
								Command="{Binding ShowNotesCommand}"
								Margin="0,5"
								ToolTip="Notes">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<TextBlock Text="📝" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
								<TextBlock Style="{StaticResource SidebarLabelTextStyle}" Text="Notes"/>
							</StackPanel>
						</Button>

                        <Button Style="{StaticResource SidebarActionButtonStyle}"
								Command="{Binding ShowFlashcardsCommand}"
								Margin="0,5"
								ToolTip="Flashcards">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<TextBlock Text="🧠" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
								<TextBlock Style="{StaticResource SidebarLabelTextStyle}" Text="Flashcards"/>
							</StackPanel>
						</Button>
                        <Separator Margin="6,10,6,10"/>

                        <Button Style="{StaticResource SidebarActionButtonStyle}"
								Click="SidebarSettingsButton_Click"
								ToolTip="{Binding [Settings], Source={StaticResource Loc}}">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<TextBlock Text="⚙" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
								<TextBlock Style="{StaticResource SidebarLabelTextStyle}" Text="{Binding [Settings], Source={StaticResource Loc}}"/>
							</StackPanel>
						</Button>

						<Button Style="{StaticResource SidebarActionButtonStyle}"
								Click="AboutButton_Click"
								ToolTip="{Binding [About], Source={StaticResource Loc}}">
							<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
								<TextBlock Text="ℹ" FontSize="14" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
								<TextBlock Style="{StaticResource SidebarLabelTextStyle}" Text="{Binding [About], Source={StaticResource Loc}}"/>
							</StackPanel>
						</Button>
					</StackPanel>
				</ScrollViewer>
			</Grid>
		</Border>


		<Grid Grid.Column="1">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<!-- Top Bar -->
			<Border Grid.Row="0"
					Background="{DynamicResource SidebarBackground}"
					BorderBrush="#E0E0E0"
					BorderThickness="0,0,0,1"
					Padding="16,10">
				<Grid>
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                     <Image Source="/NoteCards;component/logo.ico"
                               Width="28"
                               Height="28"
                               Margin="0,0,8,0"
                               VerticalAlignment="Center"/>

						<TextBlock Text="NoteCards"
                                   FontSize="22"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextColor}"
                                   VerticalAlignment="Center"/>

					</StackPanel>
					<Grid HorizontalAlignment="Right"
						  VerticalAlignment="Center">
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
							<ColumnDefinition Width="Auto"/>
                           <ColumnDefinition Width="Auto"/>
						</Grid.ColumnDefinitions>

						<Border x:Name="TopSearchPanel"
								Grid.Column="0"
								Width="0"
								Height="34"
								Margin="0,0,8,0"
								Padding="10,0"
								Visibility="Collapsed"
                                Background="{DynamicResource CardBackground}"
								BorderBrush="{DynamicResource BorderColor}"
								BorderThickness="1"
								CornerRadius="8"
								Opacity="0">
							<DockPanel LastChildFill="True">
                              <TextBlock Text="🔎"
                                    Foreground="{DynamicResource TextColorSecondary}"
										   Margin="0,0,8,0"
                                        VerticalAlignment="Center"
										   FontSize="13"/>
								<TextBox x:Name="TopSearchTextBox"
										 BorderThickness="0"
										 Background="Transparent"
										 Foreground="{DynamicResource TextColor}"
										 CaretBrush="{DynamicResource TextColor}"
 										 VerticalContentAlignment="Center"
 										 Text="{Binding ActiveSearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
 										 ToolTip="{Binding [SearchNotesHint], Source={StaticResource Loc}}"
										 KeyDown="TopSearchTextBox_KeyDown"/>
							</DockPanel>
						</Border>

						<Button x:Name="TopSearchButton"
								Grid.Column="1"
                                Style="{StaticResource TopBarIconButtonStyle}"
                              Content="🔎"
                               FontSize="14"
								Margin="0,0,8,0"
								ToolTip="{Binding [Search], Source={StaticResource Loc}}"
								Click="TopSearchButton_Click"/>

						<Button x:Name="SortNotesButton"
								Grid.Column="2"
                             Style="{StaticResource TopBarIconButtonStyle}"
								Content="⇅"
								FontSize="14"
								Margin="0,0,8,0"
								ToolTip="{Binding ActiveSortButtonText}"
								Click="SortNotesButton_Click"/>

						<Button x:Name="TagsFilterButton"
							 Grid.Column="3"
                              Style="{StaticResource TopBarIconButtonStyle}"
							  Content="🏷"
							   FontSize="14"
								Margin="0,0,8,0"
								ToolTip="{Binding ActiveTagFilterButtonText}"
								Click="TagsFilterButton_Click"/>

						<Button x:Name="DashboardSectionsButton"
								Grid.Column="4"
								Style="{StaticResource TopBarIconButtonStyle}"
								Content="☷"
								FontSize="14"
								Margin="0,0,8,0"
                                ToolTip="{Binding [DashboardSections], Source={StaticResource Loc}}"
								Click="DashboardSectionsButton_Click"/>

					</Grid>
				</Grid>
			</Border>

			<Popup x:Name="SortNotesPopup"
				   Grid.Row="0"
				   PlacementTarget="{Binding ElementName=SortNotesButton}"
				   Placement="Bottom"
				   StaysOpen="False"
				   AllowsTransparency="True"
				   PopupAnimation="Fade">
				<Border Background="{DynamicResource SidebarBackground}"
						BorderBrush="#D8D8D8"
						BorderThickness="1"
						CornerRadius="10"
						MinWidth="260"
						MaxWidth="320"
						Padding="8"
						Margin="12,10,12,14">
					<Border.Effect>
						<DropShadowEffect Color="#000000" Opacity="0.14" BlurRadius="14" ShadowDepth="1" Direction="270"/>
					</Border.Effect>
					<StackPanel>
						<TextBlock Text="{Binding ActiveSortButtonText}"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource TextColor}"
								   Margin="6,3,6,8"/>
						<Border Background="{DynamicResource CardBackground}"
								CornerRadius="8"
								Padding="8,8">
							<ItemsControl ItemsSource="{Binding ActiveSortOptions}">
								<ItemsControl.ItemTemplate>
                                   <DataTemplate>
										<RadioButton GroupName="NoteSortOptionGroup"
												 Content="{Binding DisplayName}"
												 IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
												 Margin="2,4"
												 Foreground="{DynamicResource TextColor}"/>
									</DataTemplate>
								</ItemsControl.ItemTemplate>
							</ItemsControl>
						</Border>
					</StackPanel>
				</Border>
			</Popup>

			<Popup x:Name="DashboardSectionsPopup"
				   Grid.Row="0"
				   PlacementTarget="{Binding ElementName=DashboardSectionsButton}"
				   Placement="Bottom"
				   StaysOpen="False"
				   AllowsTransparency="True"
				   PopupAnimation="Fade">
				<Border Background="{DynamicResource SidebarBackground}"
						BorderBrush="#D8D8D8"
						BorderThickness="1"
						CornerRadius="10"
						MinWidth="220"
						MaxWidth="300"
						Padding="8"
						Margin="12,10,12,14">
					<Border.Effect>
						<DropShadowEffect Color="#000000" Opacity="0.14" BlurRadius="14" ShadowDepth="1" Direction="270"/>
					</Border.Effect>
					<StackPanel>
						<TextBlock Text="{Binding [DashboardSections], Source={StaticResource Loc}}"
								   FontWeight="SemiBold"
								   Foreground="{DynamicResource TextColor}"
								   Margin="6,3,6,8"/>
						<Border Background="{DynamicResource CardBackground}"
								CornerRadius="8"
								Padding="10,10">
                            <Grid>
							<StackPanel Visibility="{Binding IsFlashcardsView, Converter={StaticResource InverseBoolToVisibilityConverter}}">
								<CheckBox Content="{Binding [RecentNotes], Source={StaticResource Loc}}"
										  IsChecked="{Binding IsRecentSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										  Margin="0,0,0,6"
										  Foreground="{DynamicResource TextColor}"/>
                             <CheckBox Content="{Binding [CalendarSection], Source={StaticResource Loc}}"
										  IsChecked="{Binding IsCalendarSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										  Margin="0,0,0,6"
										  Foreground="{DynamicResource TextColor}"/>
								<CheckBox Content="{Binding [Groups], Source={StaticResource Loc}}"
										  IsChecked="{Binding IsGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										  Margin="0,0,0,6"
										  Foreground="{DynamicResource TextColor}"/>
								<CheckBox Content="{Binding [UngroupedNotes], Source={StaticResource Loc}}"
										  IsChecked="{Binding IsUngroupedSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
										  Foreground="{DynamicResource TextColor}"/>
							</StackPanel>
                            <StackPanel Visibility="{Binding IsFlashcardsView, Converter={StaticResource BoolToVis}}">
                                <CheckBox Content="{Binding [FlashcardGroupsDashboardTitle], Source={StaticResource Loc}}"
                                          IsChecked="{Binding IsFlashcardGroupsSectionVisible, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Foreground="{DynamicResource TextColor}"/>
                            </StackPanel>
                            </Grid>
						</Border>
					</StackPanel>
				</Border>
			</Popup>

			<Popup x:Name="TagsFilterPopup"
				   Grid.Row="0"
				   PlacementTarget="{Binding ElementName=TagsFilterButton}"
				   Placement="Bottom"
				   StaysOpen="False"
				   AllowsTransparency="True"
				   PopupAnimation="Fade">
				<Border Background="{DynamicResource SidebarBackground}"
						BorderBrush="#D8D8D8"
						BorderThickness="1"
						CornerRadius="10"
						MinWidth="260"
						MaxWidth="320"
						Padding="8"
						Margin="12,10,12,14">
					<Border.Effect>
						<DropShadowEffect Color="#000000" Opacity="0.14" BlurRadius="14" ShadowDepth="1" Direction="270"/>
					</Border.Effect>
					<StackPanel>
						<Grid Margin="4,2,4,8">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="Auto"/>
							</Grid.ColumnDefinitions>
							<TextBlock Text="{Binding [FilterTags], Source={StaticResource Loc}}"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource TextColor}"
									   VerticalAlignment="Center"/>
							<Button Grid.Column="1"
									Style="{StaticResource PopupMenuButtonStyle}"
									Padding="8,4"
									Content="{Binding [ClearFilters], Source={StaticResource Loc}}"
									Command="{Binding ClearTagFiltersCommand}"/>
						</Grid>
						<Border Background="{DynamicResource CardBackground}"
								CornerRadius="8"
								Padding="10,14"
								Visibility="{Binding ActiveHasTagFilters, Converter={StaticResource BoolToVis}}">
							<ScrollViewer MaxHeight="230" VerticalScrollBarVisibility="Auto">
								<ItemsControl ItemsSource="{Binding ActiveTagFilters}">
									<ItemsControl.ItemTemplate>
										<DataTemplate DataType="{x:Type vm:TagFilterItemViewModel}">
											<CheckBox Content="{Binding Tag}"
													  IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
													  Margin="0,2"
													  Foreground="{DynamicResource TextColor}"/>
										</DataTemplate>
									</ItemsControl.ItemTemplate>
								</ItemsControl>
							</ScrollViewer>
						</Border>
                      <TextBlock Text="{Binding [NoTagsFound], Source={StaticResource Loc}}"
								   Margin="4,8,4,6"
								   FontStyle="Italic"
								   Foreground="#7A7F90">
							<TextBlock.Style>
								<Style TargetType="TextBlock">
									<Setter Property="Visibility" Value="Collapsed"/>
									<Style.Triggers>
										<DataTrigger Binding="{Binding ActiveHasTagFilters}" Value="False">
											<Setter Property="Visibility" Value="Visible"/>
										</DataTrigger>
									</Style.Triggers>
								</Style>
							</TextBlock.Style>
						</TextBlock>
					</StackPanel>
				</Border>
			</Popup>

			<!-- Dashboard + FAB overlay -->
            <Grid Grid.Row="1">
                
                <!-- NOTES VIEW -->
                <Grid Visibility="{Binding IsFlashcardsView, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- Recent Notes strip -->
                    <Border Grid.Row="0"
                        Visibility="{Binding IsFlashcardsView, Converter={StaticResource InverseBoolToVisibilityConverter}}"
						Background="{DynamicResource SidebarBackground}"
						BorderBrush="{DynamicResource BorderColor}"
                       BorderThickness="0,0,0,1"
						Padding="16,12">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
									ToolTip="{Binding [ToggleRecentNotesSection], Source={StaticResource Loc}}"
									Click="ToggleRecentSectionButton_Click">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource DashboardSectionToggleButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRecentSectionExpanded}" Value="False">
                                                    <Setter Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="-90"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <TextBlock Grid.Column="1"
									   Text="{Binding [RecentNotes], Source={StaticResource Loc}}"
									   FontSize="13"
									   FontWeight="SemiBold"
									   Foreground="{DynamicResource TextColor}"
									Margin="8,0,0,0"
									   FontFamily="Segoe UI Variable, Segoe UI, sans-serif"
									   VerticalAlignment="Center"/>
                            </Grid>
                            <Border x:Name="RecentSectionBody"
								Margin="0,10,0,0"
								RenderTransformOrigin="0.5,0">
                                <Border.RenderTransform>
                                    <TranslateTransform/>
                                </Border.RenderTransform>
                                <ScrollViewer x:Name="RecentNotesScrollViewer"
										  HorizontalScrollBarVisibility="Auto"
										  VerticalScrollBarVisibility="Disabled"
										  CanContentScroll="True"
										  PanningMode="HorizontalOnly"
										  PreviewMouseWheel="RecentNotesScrollViewer_PreviewMouseWheel">
                                    <ItemsControl ItemsSource="{Binding RecentNotes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:NoteCardViewModel}">
                                                <Button Style="{StaticResource RecentNoteCardStyle}"
													Tag="{Binding}"
													Click="RecentNoteButton_Click">
                                                    <StackPanel MinWidth="120" MaxWidth="180">
                                                        <TextBlock Text="{Binding Document.Title}"
															   FontWeight="SemiBold"
															   FontSize="13"
															   TextTrimming="CharacterEllipsis"
															   Foreground="{DynamicResource TextColor}"/>
                                                        <TextBlock Text="{Binding Document.LastModified, StringFormat='{}{0:dd MMM, HH:mm}'}"
															   FontSize="11"
															   Foreground="{DynamicResource TextColor}"
															   Margin="0,4,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>
                    <!-- All Notes + FAB -->
                    <Grid Grid.Row="1">
                        <ScrollViewer x:Name="NotesScrollViewer"
								 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Disabled"
								 Padding="8"
								 AllowDrop="True"
								 PreviewDragOver="NotesScrollViewer_PreviewDragOver"
								 PreviewMouseWheel="NotesScrollViewer_PreviewMouseWheel">
                            <Grid Margin="0,0,0,18">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border x:Name="CalendarSectionContainer"
									Visibility="{Binding IsCalendarSectionVisible, Converter={StaticResource BoolToVis}}"
                                    Background="{DynamicResource SidebarBackground}"
									BorderBrush="{DynamicResource BorderColor}"
									BorderThickness="1"
                                   CornerRadius="14"
									Padding="12"
									Margin="8,0,8,10"
									RenderTransformOrigin="0.5,0.5">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="14" ShadowDepth="1" Direction="270"/>
                                    </Border.Effect>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Grid.Row" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCalendarFirst}" Value="False">
                                                    <Setter Property="Grid.Row" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <Grid Margin="2,0,2,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                Style="{StaticResource DashboardSectionMoveButtonStyle}"
												Content="↑"
												Margin="0,0,2,0"
												ToolTip="{Binding [MoveCalendarSectionUp], Source={StaticResource Loc}}"
												Click="MoveCalendarUpButton_Click"/>
                                            <Button Grid.Column="1"
												Style="{StaticResource DashboardSectionMoveButtonStyle}"
												Content="↓"
												Margin="0,0,4,0"
												ToolTip="{Binding [MoveCalendarSectionDown], Source={StaticResource Loc}}"
												Click="MoveCalendarDownButton_Click"/>
                                            <Button Grid.Column="2"
												ToolTip="{Binding [ToggleCalendarSection], Source={StaticResource Loc}}"
												Click="ToggleCalendarSectionButton_Click">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource DashboardSectionToggleButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCalendarSectionExpanded}" Value="False">
                                                                <Setter Property="RenderTransform">
                                                                    <Setter.Value>
                                                                        <RotateTransform Angle="-90"/>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
