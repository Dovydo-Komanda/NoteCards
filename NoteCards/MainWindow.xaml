                                                            BorderThickness="0"
                                                            Cursor="Hand">
                                                        <Border x:Name="FlashcardSetCardBorder"
                                                                Background="{DynamicResource CardBackground}"
                                                                BorderBrush="{DynamicResource BorderColor}"
                                                                BorderThickness="1"
                                                                CornerRadius="14"
                                                                Padding="16"
                                                                Opacity="0"
                                                                RenderTransformOrigin="0.5,0.5">
                                                            <Border.RenderTransform>
                                                                <TransformGroup>
                                                                    <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                                                    <TranslateTransform Y="10"/>
                                                                </TransformGroup>
                                                            </Border.RenderTransform>
                                                            <Border.Triggers>
                                                                <EventTrigger RoutedEvent="Loaded">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                                             From="0"
                                                                                             To="1"
                                                                                             Duration="0:0:0.22">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"
                                                                                             From="10"
                                                                                             To="0"
                                                                                             Duration="0:0:0.22">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <QuadraticEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                                             From="0.98"
                                                                                             To="1"
                                                                                             Duration="0:0:0.22"/>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                                             From="0.98"
                                                                                             To="1"
                                                                                             Duration="0:0:0.22"/>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                                <EventTrigger RoutedEvent="MouseEnter">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="FlashcardSetCardBorder"
                                                                                             Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                                                             To="14"
                                                                                             Duration="0:0:0.18">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="FlashcardSetCardBorder"
                                                                                             Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                                                             To="0.18"
                                                                                             Duration="0:0:0.18">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                                             To="1.02"
                                                                                             Duration="0:0:0.18">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                                             To="1.02"
                                                                                             Duration="0:0:0.18">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                                <EventTrigger RoutedEvent="MouseLeave">
                                                                    <BeginStoryboard>
                                                                        <Storyboard>
                                                                            <DoubleAnimation Storyboard.TargetName="FlashcardSetCardBorder"
                                                                                             Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)"
                                                                                             To="8"
                                                                                             Duration="0:0:0.2">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetName="FlashcardSetCardBorder"
                                                                                             Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)"
                                                                                             To="0.08"
                                                                                             Duration="0:0:0.2">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"
                                                                                             To="1.0"
                                                                                             Duration="0:0:0.2">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"
                                                                                             To="1.0"
                                                                                             Duration="0:0:0.2">
                                                                                <DoubleAnimation.EasingFunction>
                                                                                    <CubicEase EasingMode="EaseOut"/>
                                                                                </DoubleAnimation.EasingFunction>
                                                                            </DoubleAnimation>
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </EventTrigger>
                                                            </Border.Triggers>
                                                            <Border.Effect>
                                                                <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="14" ShadowDepth="1" Direction="270"/>
                                                            </Border.Effect>
                                                            <Grid>
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="Auto"/>
                                                                    <RowDefinition Height="*"/>
                                                                    <RowDefinition Height="Auto"/>
                                                                </Grid.RowDefinitions>
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding Title}"
                                                                               FontSize="17"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource TextColor}"
                                                                               TextTrimming="CharacterEllipsis"/>
                                                                    <Border Grid.Column="1"
                                                                            Width="24"
                                                                            Height="24"
                                                                            CornerRadius="12"
                                                                            Background="{DynamicResource IconButtonBackground}"
                                                                            BorderBrush="{DynamicResource IconButtonBorder}"
                                                                            BorderThickness="1"
                                                                            ToolTip="{Binding AiGeneratedTooltip}"
                                                                            Visibility="{Binding IsAiGenerated, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="🤖"
                                                                                   FontSize="13"
                                                                                   Foreground="{DynamicResource TextColorSecondary}"
                                                                                   HorizontalAlignment="Center"
                                                                                   VerticalAlignment="Center"/>
                                                                    </Border>
                                                                </Grid>

                                                                <StackPanel Grid.Row="1"
                                                                            Orientation="Horizontal"
                                                                            Margin="0,14,0,0">
                                                                    <TextBlock Text="{Binding CardCountText}"
                                                                               FontSize="13"
                                                                               Foreground="{DynamicResource TextColorSecondary}"/>
                                                                    <TextBlock Text="  •  "
                                                                               FontSize="13"
                                                                               Foreground="{DynamicResource TextColorSecondary}"/>
                                                                    <TextBlock Text="{Binding SetCountText}"
                                                                               FontSize="13"
                                                                               Foreground="{DynamicResource TextColorSecondary}"/>
                                                                </StackPanel>

                                                                <TextBlock Grid.Row="2"
                                                                           Text="{Binding TagsDisplay}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource TextColorSecondary}"
                                                                           TextWrapping="Wrap"
                                                                           MaxHeight="38"
                                                                           Visibility="{Binding HasTags, Converter={StaticResource BoolToVis}}"/>
                                                            </Grid>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasFlashcardSets, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                            <TextBlock Text="{Binding [FlashcardsEmptyDashboardPrompt], Source={StaticResource Loc}}"
                                       FontSize="18"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource TextColorSecondary}"
                                       HorizontalAlignment="Center"
                                       Margin="0,0,0,8"/>
                            <Button Content="{Binding [CreateFlashcards], Source={StaticResource Loc}}"
                                    Style="{StaticResource DialogPrimaryButtonStyle}"
                                    MinWidth="180"
                                    Padding="18,10"
                                    Click="CreateFlashcardsButton_Click"/>
                        </StackPanel>

                        <Button Style="{StaticResource FabStyle}"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Right"
                                Margin="0,0,28,24"
                                Content="+"
                                ToolTip="{Binding [CreateFlashcards], Source={StaticResource Loc}}"
                                Click="CreateFlashcardsButton_Click"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

		<Views:SettingsPanel x:Name="SettingsPanelControl"
						 x:FieldModifier="public"
						 Grid.ColumnSpan="2"
						 Visibility="Collapsed"
						 HorizontalAlignment="Stretch"
						 VerticalAlignment="Stretch"
						 Panel.ZIndex="200"/>

		<Views:AboutPanel x:Name="AboutPanelControl"
					  x:FieldModifier="public"
					  Grid.ColumnSpan="2"
					  Visibility="Collapsed"
					  HorizontalAlignment="Stretch"
					  VerticalAlignment="Stretch"
					  Panel.ZIndex="201"/>

		<Views:NoteSchedulePanel x:Name="NoteSchedulePanelControl"
							 x:FieldModifier="public"
							 Grid.ColumnSpan="2"
							 Visibility="Collapsed"
							 HorizontalAlignment="Stretch"
							 VerticalAlignment="Stretch"
							 Panel.ZIndex="202"/>
        <Grid Visibility="{Binding SelectedFlashcard, Converter={StaticResource NullToVisibilityConverter}}"
      Background="#80000000"
      Panel.ZIndex="9999"
      Grid.ColumnSpan="2"
      Grid.RowSpan="2">

            <Grid HorizontalAlignment="Center"
          VerticalAlignment="Center">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="400"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- PREVIOUS -->
                <Button Grid.Column="0"
                Content="◀"
                Width="40"
                Height="60"
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                Command="{Binding PreviousFlashcardCommand}"/>

                <!-- CARD -->
                <Border Grid.Column="1"
                Width="400"
                Padding="20"
				Background="{DynamicResource CardBackground}"
				BorderBrush="{DynamicResource BorderColor}"
				BorderThickness="1"
                CornerRadius="10">

                    <StackPanel>

                        <TextBlock Text="{Binding SelectedFlashcard.Question}"
                           FontSize="18"
                           FontWeight="Bold"
							  Foreground="{DynamicResource TextColor}"
                           TextAlignment="Center"
                           Visibility="{Binding IsShowingAnswer, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>

                        <TextBlock Text="{Binding SelectedFlashcard.Answer}"
                           FontSize="18"
							  Foreground="{DynamicResource TextColor}"
                           TextAlignment="Center"
                           Visibility="{Binding IsShowingAnswer, Converter={StaticResource BoolToVis}}"/>

                        <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,20,0,0">

                            <Button Content="Flip"
                            Command="{Binding FlipFlashcardCommand}"
                            Margin="5"/>

                            <Button Content="Close"
                            Command="{Binding CloseFlashcardCommand}"
                            Margin="5"/>

                        </StackPanel>

                    </StackPanel>

                </Border>

                <!-- NEXT -->
                <Button Grid.Column="2"
                Content="▶"
                Width="40"
                Height="60"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                Command="{Binding NextFlashcardCommand}"/>

            </Grid>

        </Grid>
    </Grid>
</Window>
